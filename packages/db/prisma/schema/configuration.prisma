// Configuration: standing facts that may change, written by the API, audited, archived or
// closed, never deleted (adms-data-model §3.1b).

// Who is paying: the jurisdiction or agency. Firm-wide and reused across disasters: a county hit
// again is the same record, picked, never re-created (adms-data-model §3.1a; ADR-023).
model Client {
  id           String  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name         String
  // Its contact, edited freely, audited.
  contactName  String? @map("contact_name")
  contactEmail String? @map("contact_email")
  contactPhone String? @map("contact_phone")
  notes        String?

  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(3)

  projects Project[]

  @@map("client")
}

// What happened: the disaster and the reference its work is authorised under. Firm-wide, created
// once and referenced by any number of projects of any number of clients (ADR-023, 026). Always the
// declaration event, never a bare "event" (spec/CONVENTIONS.md §2).
model DeclarationEvent {
  id              String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name            String
  // As written: DR-9001-FL, or a state, local or internal reference. Text, never parsed.
  reference       String
  // What kind of reference it is: picked from the firm's list, never typed (ADR-070).
  referenceTypeId String @map("reference_type_id") @db.Uuid

  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(3)

  referenceType DeclarationReferenceType @relation(fields: [referenceTypeId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  projects      Project[]

  @@map("declaration_event")
}

// Where a project's ticket numbers come from: pre-printed control tickets, their ranges entered at
// setup, or numbers generated in blocks on each phone (ADR-056). The series and ranges themselves
// are the numbering models' (spec/DATA-MODEL.md §3, Numbering).
enum TicketNumberSource {
  CONTROL
  GENERATED

  @@map("ticket_number_source")
}

// One body of work for one client under one declaration event: the hub (adms-data-model §3.1a).
// A separate project per funder or kind of work; there is no funder field (ADR-148).
// What each setting starts as on a new project is packages/domain's (NewProjectSettings), from the
// policy values: no setting has a default here, so every writer says what it set (invariant 16).
model Project {
  id                 String             @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name               String
  clientId           String             @map("client_id") @db.Uuid
  declarationEventId String             @map("declaration_event_id") @db.Uuid
  // The kind of work, from the firm's list. Its "requires ROE" drives the ROE checks (ADR-149).
  programTypeId      String             @map("program_type_id") @db.Uuid
  // Whether "normal or split?" is asked; starts ticked where the program type requires ROEs, and
  // the firm may change it either way (ADR-137).
  allowSplitLoads    Boolean            @map("allow_split_loads")
  // IANA name, e.g. America/New_York: "which day" questions use it (ADR-100). A check in the guard
  // migrations refuses anything else (ADR-281).
  timeZone           String             @map("time_zone")
  // The active window: calendar days in the project's time zone, judged by a load's time, its
  // collection's end (ADR-161). A ticket outside it is flagged, never refused; the end may be empty.
  activeFrom         DateTime           @map("active_from") @db.Date
  activeTo           DateTime?          @map("active_to") @db.Date
  ticketNumberSource TicketNumberSource @map("ticket_number_source")
  // The ticket types it allows (ADR-041).
  workflows          Workflow[]

  // A load call at or under the low limit, or at or over the high one, is flagged; empty = off.
  // A 0% call is flagged either way (ADR-164, 181).
  loadCallLowLimit            Int?    @map("load_call_low_limit")
  loadCallHighLimit           Int?    @map("load_call_high_limit")
  // The root-ball height the fill CY is worked out with (ADR-203).
  stumpFillDepthInches        Int     @map("stump_fill_depth_inches")
  // The two built-in stump checks: root ball not wider than the stump; fill paid with the root ball
  // not half exposed. Both still bill (ADR-203).
  stumpCheckRootBallWider     Boolean @map("stump_check_root_ball_wider")
  stumpCheckFillNeedsExposure Boolean @map("stump_check_fill_needs_exposure")
  // The circle round a site's GPS, for every site of the project without its own shape (ADR-142).
  siteCircleMeters            Int     @map("site_circle_meters")
  // The optional time clock, per project (ADR-241).
  timeClockEnabled            Boolean @map("time_clock_enabled")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  closedAt  DateTime? @map("closed_at") @db.Timestamptz(3)

  client           Client              @relation(fields: [clientId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  declarationEvent DeclarationEvent    @relation(fields: [declarationEventId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  programType      ProgramType         @relation(fields: [programTypeId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  kindsOfWork      ProjectKindOfWork[]
  contractors      ProjectContractor[]
  contracts        Contract[]
  forms            Form[]
  disposalSites    DisposalSite[]
  payItems         PayItem[]
  assignments      Assignment[]
  numberBlocks     NumberBlock[]
  fieldTags        FieldTag[]
  fieldEvents      FieldEvent[]
  completedLoads   CompletedLoad[]

  // "Every project under this declaration", and a client's projects, are one query each (ADR-026).
  @@index([declarationEventId])
  @@index([clientId])
  @@map("project")
}

// One of the kinds of unit rate work a project allows (ADR-127). Taken off the project by
// archiving, never deleted; put back by clearing the archive.
model ProjectKindOfWork {
  id           String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  projectId    String @map("project_id") @db.Uuid
  kindOfWorkId String @map("kind_of_work_id") @db.Uuid

  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(3)

  project    Project    @relation(fields: [projectId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  kindOfWork KindOfWork @relation(fields: [kindOfWorkId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([projectId, kindOfWorkId])
  @@map("project_kind_of_work")
}

// What a contractor is to the firm: a hauling company, an employer of monitors (a monitoring sub or
// a temp agency), a crew, or something else (Q-97, spec/FROM-BUILD-1.md).
enum ContractorKind {
  HAULER
  MONITORING
  CREW
  OTHER

  @@map("contractor_kind")
}

// A hauling company, prime or sub, or a monitoring firm or temp agency that employs monitors;
// firm-wide (adms-data-model §3.1a; Q-97). Whether it is a prime or a sub is its place on each
// project (ProjectContractor), never a fact about the contractor itself.
model Contractor {
  id           String         @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name         String
  // Whoever adds it says which: there is no default.
  kind         ContractorKind
  // Its contact, as a client's: edited freely, audited (the user, ADR-306).
  contactName  String?        @map("contact_name")
  contactEmail String?        @map("contact_email")
  contactPhone String?        @map("contact_phone")
  // A sub typed twice at certification under two spellings: the back office merges one into the
  // other, audited. The merged one is archived, never deleted (ADR-108; checks in the guard
  // migration).
  mergedIntoId String?        @map("merged_into_id") @db.Uuid

  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(3)

  mergedInto   Contractor?         @relation("Merged", fields: [mergedIntoId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  merged       Contractor[]        @relation("Merged")
  // Its place on each project it works on.
  projects     ProjectContractor[]
  // The contracts it holds, each as one of its project's primes.
  contracts    Contract[]
  // Its rate on each pay item, as one of the project's primes (ADR-206).
  payItemRates PayItemRate[]
  // A contractor user sees only its own transactions (ADR-169).
  users        User[]              @relation("ViewerContractor")
  // The people it employs (Q-97).
  employees    User[]              @relation("Employer")
  transactions Transaction[]

  @@map("contractor")
}

// A contractor's place on a project: a prime, or a sub in the first or second tier under one of the
// project's primes. There is no third tier (ADR-108).
enum ContractorPosition {
  PRIME
  SUB_TIER_1
  SUB_TIER_2

  @@map("contractor_position")
}

// A contractor's place on one project. A project may have several primes; each prime's subs are its
// own, at most two tiers, never shared: a contractor has one place on a project (ADR-108). A prime
// is added at setup; a sub's row is made when it's typed in at certification under its prime.
model ProjectContractor {
  id           String             @id @default(dbgenerated("uuidv7()")) @db.Uuid
  projectId    String             @map("project_id") @db.Uuid
  contractorId String             @map("contractor_id") @db.Uuid
  position     ContractorPosition
  // The prime a sub works under, tier 1 and tier 2 alike; a prime names none (a check in the guard
  // migration).
  primeId      String?            @map("prime_id") @db.Uuid
  // On a prime's row, its own contractor again; empty on a sub's (a check in the guard migration).
  // It is what "the prime" points at: a sub's primeId and a contract's are held to it by a
  // two-column foreign key, so the database refuses naming anyone but one of this project's primes,
  // and refuses making a prime a sub while anything names it.
  asPrimeId    String?            @map("as_prime_id") @db.Uuid

  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  // Taken off the project; never deleted.
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(3)

  project    Project             @relation(fields: [projectId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  contractor Contractor          @relation(fields: [contractorId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  prime      ProjectContractor?  @relation("PrimeSubs", fields: [projectId, primeId], references: [projectId, asPrimeId], onDelete: Restrict, onUpdate: Restrict)
  subs       ProjectContractor[] @relation("PrimeSubs")
  contracts  Contract[]
  rates      PayItemRate[]

  // One place on a project: a sub is never shared by two primes.
  @@unique([projectId, contractorId])
  // What a sub's prime and a contract's prime point at.
  @@unique([projectId, asPrimeId])
  @@map("project_contractor")
}

// A name, its prime and an optional link to the signed copy: nothing else, no number, dates or
// amount (ADR-146). The prime is added to the project first; a prime may hold one contract on a
// project or several. A pricing rule names one contract and runs only on its prime's tickets
// (ADR-239).
model Contract {
  id            String  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  projectId     String  @map("project_id") @db.Uuid
  name          String
  // One of its own project's primes: the second relation below holds it to that.
  primeId       String  @map("prime_id") @db.Uuid
  // Where the signed copy is kept, as the firm wrote it.
  signedCopyUrl String? @map("signed_copy_url")

  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(3)

  project    Project           @relation(fields: [projectId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  prime      Contractor        @relation(fields: [primeId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  primePlace ProjectContractor @relation(fields: [projectId, primeId], references: [projectId, asPrimeId], onDelete: Restrict, onUpdate: Restrict)

  @@index([projectId])
  @@map("contract")
}

// What a form is for (ADR-211): the three workflows' tickets, a truck certificate, and the four
// kinds of record that are never a ticket's events (ADR-236).
enum FormDocumentType {
  LOAD
  HAUL_OUT
  UNIT_RATE
  CERTIFICATION
  ROE
  SURVEY
  INCIDENT
  DROP_OFF_LOG

  @@map("form_document_type")
}

// A project's form for one document type, the legacy "Document Format" (ADR-211): at most one of
// each on a project, archived ones included. Debris types are added to a load or haul-out form;
// the firm's own fields to an ROE, survey, incident or drop-off log form (ADR-160, 188, 308).
model Form {
  id           String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  projectId    String           @map("project_id") @db.Uuid
  name         String
  documentType FormDocumentType @map("document_type")
  // Read on the forms that aren't a workflow's: incidents and drop-off logs are switched on per
  // project (ADR-188). Whether a load, haul-out or unit rate form is used is the project's
  // workflows' to say (ADR-041, 308).
  enabled      Boolean
  // "GPS required": a setting of the ROE form alone, which states it (ADR-181; a check in the
  // guard migration).
  gpsRequired  Boolean?         @map("gps_required")

  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(3)

  project     Project          @relation(fields: [projectId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  debrisTypes FormDebrisType[]
  definitions FormDefinition[]

  @@unique([projectId, documentType])
  // What a debris type's entry and a definition point at, so each is held to the forms it belongs
  // on, and a form's document type can't change under them.
  @@unique([id, documentType])
  @@map("form")
}

// A debris type added to a load or haul-out form, named as the contract names the work: Mulch and
// Ash are two entries (ADR-211, 214). A field event points at the entry, so a rule's Debris type
// matches the exact entry (ADR-226). Taken off by archiving; never deleted.
model FormDebrisType {
  id                String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  formId            String           @map("form_id") @db.Uuid
  // Its form's, again: LOAD or HAUL_OUT, held by a check and by the relation to the form.
  documentType      FormDocumentType @map("document_type")
  // From the firm's library.
  debrisTypeId      String           @map("debris_type_id") @db.Uuid
  // Already reduced: a helper for rules, reports and checks. Not ticked on a haul-out form, setup
  // warns and saves it (packages/domain's DebrisTypeEntries; ADR-214).
  reduced           Boolean
  reductionMethodId String?          @map("reduction_method_id") @db.Uuid
  // Off the phones' list for this form; field events that carry it keep it (ADR-214).
  hiddenOnPhones    Boolean          @map("hidden_on_phones")

  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(3)

  form            Form             @relation(fields: [formId, documentType], references: [id, documentType], onDelete: Restrict, onUpdate: Restrict)
  debrisType      DebrisType       @relation(fields: [debrisTypeId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  reductionMethod ReductionMethod? @relation(fields: [reductionMethodId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([formId, debrisTypeId])
  @@map("form_debris_type")
}

// One version of the firm's added fields on a project's ROE, survey, incident or drop-off log form
// (ADR-160, 188, 278, 308). A change is a new version, numbered from 1; a version is never edited
// or deleted (the guard migration). Each record made on the form keeps the version it answered.
// Nothing the engine, a rule or a flag reads is ever in it.
model FormDefinition {
  id           String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  formId       String           @map("form_id") @db.Uuid
  // Its form's, again: one of the four, held by a check and by the relation to the form.
  documentType FormDocumentType @map("document_type")
  version      Int
  // Each field's stable id, label, type, whether it's required, and a pick's choices: the shape is
  // packages/contracts' formDefinitionFields.
  fields       Json
  createdById  String           @map("created_by_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  form      Form @relation(fields: [formId, documentType], references: [id, documentType], onDelete: Restrict, onUpdate: Restrict)
  createdBy User @relation("FormDefinitionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([formId, version])
  @@map("form_definition")
}

// Where debris legally goes, entered on each project that uses it, never shared (ADR-145).
// PROVISIONAL: only what an assignment's site needs. Its site type, facts, permit, GPS, area and
// dates are spec/DATA-MODEL.md's (adms-ticket-workflows §4.0).
model DisposalSite {
  id        String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  projectId String @map("project_id") @db.Uuid
  name      String

  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(3)

  project     Project      @relation(fields: [projectId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  assignments Assignment[]

  // So an assignment's site can only be one of its own project's (its relation's target).
  @@unique([projectId, id])
  @@map("disposal_site")
}

// A pay item's Unit of Measure (spec/CONVENTIONS.md §4; ADR-221, 223): TN or LB means the load is
// weighed. TBN bills nothing until a price is agreed (Q-22).
enum BillingUnit {
  CY
  TN
  EA
  LB
  HR
  CREW_DAY
  TBN

  @@map("billing_unit")
}

// How a crew-time ticket's hours become a quantity: per hour; a crew day by exact division by the
// day length; or a crew day in the steps the firm sets. The only three (ADR-087).
enum CrewTimeConversion {
  PER_HOUR
  PER_DAY_EXACT
  PER_DAY_STEPS

  @@map("crew_time_conversion")
}

// A priced line of the contract as the firm sets it up: the only place a rate lives (ADR-206, 237).
// It names no form: a rule does, so one pay item can be added by a Load rule and a Haul-out rule
// (ADR-292). A unit rate pay item is known by its kind of work (ADR-127). Its rate for each prime
// is PayItemRate's; no setting has a default here, so every writer says what it set (ADR-303).
model PayItem {
  id                         String              @id @default(dbgenerated("uuidv7()")) @db.Uuid
  projectId                  String              @map("project_id") @db.Uuid
  // The firm's own string; setup suggests one from the convention (VEG-HAUL-CY-15), ADR-235. No two
  // pay items of a project share one, archived ones included: a rate that changes from a date is a
  // second pay item with a code of its own, whatever the firm calls it (ADR-301).
  code                       String
  // What the work is, in the firm's own words ("ROW VEG haul 0–15 mi"); shown beside the code.
  description                String
  // The work it prices, from the firm's list: what a unit rate monitor picks, and what exports
  // group lines by. Every pay item has one, on loads, haul-outs and fees alike (ADR-221).
  payableTypeId              String              @map("payable_type_id") @db.Uuid
  unit                       BillingUnit
  // Set on a unit rate pay item, and only there (ADR-127, 292).
  kindOfWorkId               String?             @map("kind_of_work_id") @db.Uuid
  // The size band, in inches, both ends included; either end may be open. Among the pay items of
  // one payable type the band picks the pay item, and bands never overlap (packages/domain's
  // SizeBands refuses them); a lone pay item's band only flags (ADR-210, 213, 217).
  bandFrom                   Decimal?            @map("band_from") @db.Decimal(8, 1)
  bandTo                     Decimal?            @map("band_to") @db.Decimal(8, 1)
  // The capture settings: each one ticked is checked by the worker, none is stored and ignored
  // (ADR-157, 192, 207, 210; KD-28).
  countIsAlwaysOne           Boolean             @map("count_is_always_one")
  gpsRequired                Boolean             @map("gps_required")
  measurementRequired        Boolean             @map("measurement_required")
  decimalsAllowed            Boolean             @map("decimals_allowed")
  photosRequired             Boolean             @map("photos_required")
  monitorMayMarkIneligible   Boolean             @map("monitor_may_mark_ineligible")
  quantityFromCarriedTickets Boolean             @map("quantity_from_carried_tickets")
  // How hours become a quantity: on an HR or CREW_DAY pay item, and only there; the day length on a
  // crew day by exact division, and only there (checks in the guard migration). A new one's day
  // length starts at the policy value CREW_DAY_HOURS (ADR-087, 309).
  crewTimeConversion         CrewTimeConversion? @map("crew_time_conversion")
  crewDayHours               Decimal?            @map("crew_day_hours") @db.Decimal(4, 2)

  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(3)

  project      Project              @relation(fields: [projectId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  payableType  PayableType          @relation(fields: [payableTypeId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  kindOfWork   KindOfWork?          @relation(fields: [kindOfWorkId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  rates        PayItemRate[]
  crewDaySteps PayItemCrewDayStep[]
  assignments  AssignmentPayItem[]

  // So a rate can only be its own project's pay item's (its relation's target).
  @@unique([projectId, id])
  // So an assignment names only its own project's unit rate pay items: its relation names the kind
  // of work too, which a pay item that isn't a unit rate one doesn't have (C42).
  @@unique([projectId, id, kindOfWorkId])
  @@unique([projectId, code])
  @@map("pay_item")
}

// One step of a crew day paid in steps: hours from, to (both included), and the quantity they bill
// (1.5–4.5 h = 0.25 of a day). Read only on a pay item paid PER_DAY_STEPS (ADR-087).
model PayItemCrewDayStep {
  id        String  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  payItemId String  @map("pay_item_id") @db.Uuid
  fromHours Decimal @map("from_hours") @db.Decimal(4, 2)
  toHours   Decimal @map("to_hours") @db.Decimal(4, 2)
  quantity  Decimal @db.Decimal(14, 4)

  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(3)

  payItem PayItem @relation(fields: [payItemId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([payItemId, fromHours])
  @@map("pay_item_crew_day_step")
}

// A pay item's rate for one prime: one pay item holds a rate for each prime, never a copy per prime
// (ADR-206). No row is no rate: a $0 line (ADR-128, 212). A rate's history is the audit log; there
// is no rate history table (ADR-090).
model PayItemRate {
  id        String  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  projectId String  @map("project_id") @db.Uuid
  payItemId String  @map("pay_item_id") @db.Uuid
  // One of the pay item's project's primes: the third relation below holds it to that (ADR-305).
  primeId   String  @map("prime_id") @db.Uuid
  rate      Decimal @db.Decimal(14, 4)

  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  // Taken off; put back by clearing the archive, never a second row for the same prime.
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(3)

  payItem    PayItem           @relation(fields: [projectId, payItemId], references: [projectId, id], onDelete: Restrict, onUpdate: Restrict)
  prime      Contractor        @relation(fields: [primeId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  primePlace ProjectContractor @relation(fields: [projectId, primeId], references: [projectId, asPrimeId], onDelete: Restrict, onUpdate: Restrict)

  @@unique([payItemId, primeId])
  @@map("pay_item_rate")
}

enum UserRole {
  ADMIN
  MANAGER_ANALYST
  MONITOR
  READ_ONLY_VIEWER
  // Not a person and never a login: the one system actor the worker writes as, seeded by the
  // installer (ADR-273).
  SYSTEM

  @@map("user_role")
}

// A person with a login; firm-wide, not project-scoped (ADR-050, 105, 169).
model User {
  id             String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name           String
  role           UserRole
  // The Monitor ID (M004127), a business number, never a key (spec/CONVENTIONS.md §3). The system
  // issues it (REQ-021): a person written without one gets the next from the database. Every
  // monitor has one; the system actor never does (checks in the guard migrations, ADR-276, 281).
  monitorNumber  String?  @unique @default(dbgenerated("next_monitor_number()")) @map("monitor_number")
  // Set for a contractor's read-only viewer (ADR-169).
  contractorId   String?  @map("contractor_id") @db.Uuid
  // Who employs them, when it isn't the firm itself: a monitoring firm or temp agency, always a
  // contractor record, never typed text; and the ID that employer gives them, if any (Q-97).
  employerId     String?  @map("employer_id") @db.Uuid
  employerNumber String?  @map("employer_number")

  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(3)

  contractor      Contractor?      @relation("ViewerContractor", fields: [contractorId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  employer        Contractor?      @relation("Employer", fields: [employerId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  assignments     Assignment[]     @relation("AssignmentPerson")
  assignmentsMade Assignment[]     @relation("AssignmentMadeBy")
  formDefinitions FormDefinition[] @relation("FormDefinitionCreatedBy")
  fieldEvents     FieldEvent[]
  invoiceLocks    InvoiceLock[]
  auditRecords    AuditRecord[]

  @@map("user")
}

// The firm's one master passcode (ADR-106), kept only as its slow hash (ARCHITECTURE §7.5). A
// change is a new version, never an edit: the highest version is the current one. The hash is
// kept out of the audit log, and only the API may read it (the guard migrations, ADR-281).
model MasterPasscode {
  id      String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  version Int    @unique
  // Argon2id, as a PHC string.
  hash    String

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  devices Device[]

  @@map("master_passcode")
}

// In service, or marked in the back office as lost or retired (ARCHITECTURE §7.4).
enum DeviceStatus {
  ACTIVE
  LOST
  RETIRED

  @@map("device_status")
}

// A phone, enrolled once with its device key; no project, no monitor (ADR-095, 240). What it may
// make comes from the assignment it holds.
model Device {
  id                    String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  // What the dispatch board calls it, e.g. P1-COL-1.
  name                  String
  // The public half of the key pair made in the phone's secure hardware (ARCHITECTURE §7.4): one
  // key, one phone.
  publicKey             String       @unique @map("public_key")
  status                DeviceStatus @default(ACTIVE)
  // Which version of the master passcode's check the phone holds; a change reaches it at its
  // next sync (ARCHITECTURE §7.5).
  masterPasscodeVersion Int          @map("master_passcode_version")
  enrolledAt            DateTime     @default(now()) @map("enrolled_at") @db.Timestamptz(3)
  // Its removal time: what it made after this arrives flagged, never refused (ADR-134). Set
  // exactly when it's lost or retired (a check in the guard migrations).
  outOfServiceAt        DateTime?    @map("out_of_service_at") @db.Timestamptz(3)

  masterPasscode MasterPasscode @relation(fields: [masterPasscodeVersion], references: [version], onDelete: Restrict, onUpdate: Restrict)
  numberBlocks   NumberBlock[]
  assignments    Assignment[]
  fieldEvents    FieldEvent[]
  auditRecords   AuditRecord[]

  @@map("device")
}

// Which of a project's number series a block comes from: one per workflow (ADR-062), and the
// project's cert numbers for a phone that certifies (ADR-151).
enum NumberSeries {
  LOAD
  HAUL_OUT
  UNIT_RATE
  CERTIFICATION

  @@map("number_series")
}

// Issued and in use; or ended: its unused rest reclaimed once the phone confirmed its last used
// number, or the whole block retired because nobody can be sure what a lost phone used (ADR-065).
enum NumberBlockStatus {
  ISSUED
  RECLAIMED
  RETIRED

  @@map("number_block_status")
}

// A run of a project's numbers issued to one phone, which gives them out in order, offline
// (ADR-065, 151). The server is the only allocator. PROVISIONAL: the series themselves, the
// control ranges and the allocator are Phase 1's (adms-ticket-workflows).
model NumberBlock {
  id             String            @id @default(dbgenerated("uuidv7()")) @db.Uuid
  deviceId       String            @map("device_id") @db.Uuid
  projectId      String            @map("project_id") @db.Uuid
  series         NumberSeries
  firstNumber    Int               @map("first_number")
  lastNumber     Int               @map("last_number")
  // The last number the phone reported using, at a sync; none yet when empty.
  lastUsedNumber Int?              @map("last_used_number")
  status         NumberBlockStatus @default(ISSUED)

  issuedAt DateTime  @default(now()) @map("issued_at") @db.Timestamptz(3)
  // When it was reclaimed or retired.
  endedAt  DateTime? @map("ended_at") @db.Timestamptz(3)

  device  Device  @relation(fields: [deviceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([projectId, series, firstNumber])
  @@index([deviceId])
  @@map("number_block")
}

// Written on the dispatch board, or made on a phone with the master passcode when its monitor had
// none: marked, never flagged (ADR-240).
enum AssignmentOrigin {
  PLANNED
  UNPLANNED

  @@map("assignment_origin")
}

// One person's work for a day: who works where, on what (ADR-240). A phone takes it at sign-in;
// what the phone may make comes from it. It never expires and never stops work.
// Its unit rate pay items are AssignmentPayItem's (ADR-286).
model Assignment {
  // Made by the database for one written on the board; an unplanned one's comes from the phone,
  // so the field events recorded under it before it syncs can name it.
  id                String             @id @default(dbgenerated("uuidv7()")) @db.Uuid
  personId          String             @map("person_id") @db.Uuid
  // The day, in the project's time zone.
  workDate          DateTime           @map("work_date") @db.Date
  projectId         String             @map("project_id") @db.Uuid
  // Their work: the kinds of field event they may record, and whether they certify (ADR-151).
  fieldEventKinds   FieldEventKind[]   @default([]) @map("field_event_kinds")
  certifying        Boolean            @default(false)
  // The forms they may make that aren't a ticket's: ROEs, surveys, incidents, drop-off logs (C42;
  // a check in the guard migration holds it to those four, ADR-308).
  formDocumentTypes FormDocumentType[] @default([]) @map("form_document_types")
  // One site, where the work is at one: a tower, either haul-out end, a drop-off log. A curb
  // collection has none (ADR-195).
  siteId            String?            @map("site_id") @db.Uuid
  // The phone: named on the board, or the one that took it. An unplanned one always has its phone.
  deviceId          String?            @map("device_id") @db.Uuid
  origin            AssignmentOrigin
  // Who wrote it on the board. An unplanned one has no author: the master passcode isn't a person.
  madeById          String?            @map("made_by_id") @db.Uuid

  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  // Withdrawn from the board; never deleted.
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(3)

  person      User                @relation("AssignmentPerson", fields: [personId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  project     Project             @relation(fields: [projectId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  site        DisposalSite?       @relation(fields: [projectId, siteId], references: [projectId, id], onDelete: Restrict, onUpdate: Restrict)
  device      Device?             @relation(fields: [deviceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  madeBy      User?               @relation("AssignmentMadeBy", fields: [madeById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  payItems    AssignmentPayItem[]
  fieldEvents FieldEvent[]

  // So its pay items can only be its own project's (their relation's target).
  @@unique([projectId, id])
  @@index([workDate, projectId])
  @@index([personId, workDate])
  @@map("assignment")
}

// One of the unit rate pay items a person does that day (ADR-127, 240; REQ-020): what the phone
// offers them, by payable type, never a rate. Taken off the assignment by archiving, never deleted;
// put back by clearing the archive.
model AssignmentPayItem {
  id           String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  assignmentId String @map("assignment_id") @db.Uuid
  // The assignment's own project, and the pay item's: both relations name it, so a pay item of
  // another project can never be on the assignment.
  projectId    String @map("project_id") @db.Uuid
  payItemId    String @map("pay_item_id") @db.Uuid
  // The pay item's kind of work, again: required here, so only a unit rate pay item can be named
  // (C42; ADR-292, 309).
  kindOfWorkId String @map("kind_of_work_id") @db.Uuid

  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(3)

  assignment Assignment @relation(fields: [projectId, assignmentId], references: [projectId, id], onDelete: Restrict, onUpdate: Restrict)
  payItem    PayItem    @relation(fields: [projectId, payItemId, kindOfWorkId], references: [projectId, id, kindOfWorkId], onDelete: Restrict, onUpdate: Restrict)

  @@unique([assignmentId, payItemId])
  @@map("assignment_pay_item")
}

// ---------------------------------------------------------------------------------------------
// The firm's lists (spec/LISTS.md Group 1; spec/DATA-MODEL.md §2.3; ADR-070, 194, 302). One table
// per list, so a picked value is a real foreign key. Every list has the same six columns:
//   key       set only on a built-in value (STUMPS): the system acts on the key, never the name. The
//             closed set is packages/domain's; only a release writes one, and a value that has one
//             is never archived (both held by the lists' guard migration)
//   name      what people pick; the firm renames it freely
//   position  the order shown
// and created_at and archived_at, as all configuration. The firm adds its own values, which have
// no key; nothing is deleted. The values each list starts with are the seed's (src/list-seeds.ts).

// What a kind of unit rate work has its monitor count (ADR-040, 084, 127).
enum CountShape {
  NUMBER
  ITEM_COUNTS
  ITEM_HOURS

  @@map("count_shape")
}

// What a certification certifies: a container, measured, or a crew, never measured; never a
// vehicle (invariants 8, 10).
enum CertificationKind {
  CONTAINER
  CREW

  @@map("certification_kind")
}

// What a reason may be picked for (ADR-173): voiding a ticket, a ticket number typed instead of
// scanned, accepting a flag (ADR-166), a record created in the back office (ADR-156).
enum ReasonUse {
  VOID
  TYPED_NUMBER
  ACCEPT_FLAG
  BACK_OFFICE_RECORD

  @@map("reason_use")
}

// The kind of work a project is (ROW, PARKS, PPDR, WATERWAY; ADR-070).
model ProgramType {
  id          String  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  key         String? @unique
  name        String
  position    Int
  // Every collection, unit rate ticket and survey on such a project carries an ROE (ADR-149); it also
  // ticks a new project's "Allow split loads" (ADR-137).
  requiresRoe Boolean @default(false) @map("requires_roe")

  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(3)

  projects Project[]

  @@map("program_type")
}

// What kind of reference a declaration event carries: FEMA's, a state's, a local one, the firm's own
// (ADR-023).
model DeclarationReferenceType {
  id       String  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  key      String? @unique
  name     String
  position Int

  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(3)

  declarationEvents DeclarationEvent[]

  @@map("declaration_reference_type")
}

// The firm's library of debris types. A project adds them to its forms, named as the contract names
// the work, and a monitor picks from the form (ADR-074, 211).
model DebrisType {
  id       String  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  key      String? @unique
  name     String
  position Int

  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(3)

  formEntries FormDebrisType[]

  @@map("debris_type")
}

// How a reduced debris type was reduced: named on its entry on a form (ADR-214).
model ReductionMethod {
  id       String  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  key      String? @unique
  name     String
  position Int

  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(3)

  formEntries FormDebrisType[]

  @@map("reduction_method")
}

// The work a pay item prices; every pay item has one, and exports group lines by it (ADR-173, 221).
model PayableType {
  id       String  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  key      String? @unique
  name     String
  position Int

  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(3)

  payItems PayItem[]

  @@map("payable_type")
}

// A kind of unit rate work: it picks the capture screen and, for an itemised kind, the item names
// offered. Each unit rate pay item names one (ADR-127). Stumps is built in (ADR-198).
model KindOfWork {
  id         String     @id @default(dbgenerated("uuidv7()")) @db.Uuid
  key        String?    @unique
  name       String
  position   Int
  // What the monitor counts: a number, a list of items with a count each, or a list of items with
  // hours each (ADR-040, 084).
  countShape CountShape @map("count_shape")

  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(3)

  itemNames ItemName[]
  projects  ProjectKindOfWork[]
  payItems  PayItem[]

  @@map("kind_of_work")
}

// An item a monitor may count on a ticket of an itemised kind of work: a washer on White Goods, a
// skid steer on Crew time (ADR-040, 084).
model ItemName {
  id           String  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  key          String? @unique
  name         String
  position     Int
  kindOfWorkId String  @map("kind_of_work_id") @db.Uuid

  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(3)

  kindOfWork KindOfWork @relation(fields: [kindOfWorkId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@map("item_name")
}

// What a certification says was certified: a dump truck, a semi-trailer (ADR-070). A list that
// describes, so the certification may also carry a typed "other".
model VehicleType {
  id        String            @id @default(dbgenerated("uuidv7()")) @db.Uuid
  key       String?           @unique
  name      String
  position  Int
  // Whether a certification of this type is of a measured container or of a crew, which is never
  // measured (invariants 8, 10).
  certifies CertificationKind

  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(3)

  @@map("vehicle_type")
}

// What a measured box after the primary is: sideboards, a dog box, wheel wells (ADR-076). Whether
// the box adds or subtracts, and its shape, are the box's own.
model VehicleFeature {
  id       String  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  key      String? @unique
  name     String
  position Int

  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(3)

  @@map("vehicle_feature")
}

// What a crew certification certifies: a bucket truck crew, a skid steer crew. The crew is its
// certification; there is no crew list (ADR-228).
model CrewType {
  id       String  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  key      String? @unique
  name     String
  position Int

  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(3)

  @@map("crew_type")
}

// What a disposal site is, and what the Disposal site type criterion tests (ADR-190, 215). TDSR/DMS
// and Final Disposal are built in (ADR-226, 227); what a site does is its own facts.
model SiteType {
  id       String  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  key      String? @unique
  name     String
  position Int

  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(3)

  @@map("site_type")
}

// The firm's own words for a site (a burn site, grinding), beside the site facts. Labels only: the
// system does nothing with one (ADR-194, 215). Starts empty.
model SiteLabel {
  id       String  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  key      String? @unique
  name     String
  position Int

  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(3)

  @@map("site_label")
}

// What happened, on an incident report: the first list after "start incident" (ADR-127).
model IncidentType {
  id       String  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  key      String? @unique
  name     String
  position Int

  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(3)

  subTypes IncidentSubType[]

  @@map("incident_type")
}

// The firm's own finer kinds under one incident type. Starts empty (ADR-129, 137).
model IncidentSubType {
  id             String  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  key            String? @unique
  name           String
  position       Int
  incidentTypeId String  @map("incident_type_id") @db.Uuid

  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(3)

  incidentType IncidentType @relation(fields: [incidentTypeId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@map("incident_sub_type")
}

// Why a person did something that needs a reason: picked from this list, never typed (ADR-173).
model Reason {
  id       String      @id @default(dbgenerated("uuidv7()")) @db.Uuid
  key      String?     @unique
  name     String
  position Int
  // Where it is offered: any of the four uses.
  uses     ReasonUse[] @default([])

  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(3)

  @@map("reason")
}

// What a survey or ROE form is for: the first list after "start survey" (ADR-129). All three it
// starts with are built in (ADR-149, 150).
model SurveyWorkType {
  id       String  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  key      String? @unique
  name     String
  position Int

  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(3)

  @@map("survey_work_type")
}

// What a worker was doing in the hours the app can't fill in from their field events: travel,
// standby, training (ADR-241).
model ClockActivity {
  id       String  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  key      String? @unique
  name     String
  position Int

  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(3)

  @@map("clock_activity")
}

// The one list that is a project's own: a tag the collecting or unit rate monitor may pick, read
// only by the Field tag criterion and exports (ADR-216, 218). Starts empty on every project.
model FieldTag {
  id        String  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  key       String? @unique
  name      String
  position  Int
  projectId String  @map("project_id") @db.Uuid

  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(3)

  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@map("field_tag")
}
