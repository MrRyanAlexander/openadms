# Open ADMS policy values: the built-in defaults (invariant 16; ADR-303).
#
# A threshold is policy, never a number in code. These are the values a release ships with: what a
# new project's settings start as, before the firm changes them on the project (audited). The names
# are packages/domain's (src/policy.ts), which refuses a value that is missing or out of range.
# No secret belongs in this file: it is committed.

# A load call at or under the low limit, or at or over the high limit, is flagged (ADR-164).
# A project may change either, or switch them off; a 0% load call is flagged either way (ADR-181).
LOAD_CALL_LOW_LIMIT=5
LOAD_CALL_HIGH_LIMIT=95

# The circle round a disposal site's GPS, in metres, for a site without its own shape (ADR-142).
# A project changes it in its GIS settings.
DISPOSAL_SITE_PROXIMITY_M=200

# The root-ball height the stump fill is worked out with, in inches: the USACE Stump Conversion
# Guide's (ADR-183, 203). A project changes it for a contract that says otherwise.
STUMP_FILL_DEPTH_INCHES=31
