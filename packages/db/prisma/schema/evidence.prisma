// Evidence: what monitors saw. Inserted by the API at sync; corrected in place by permission,
// audited; voided, never deleted. The worker writes only the reconciliation columns
// (adms-data-model §3.1b, §3.1c; ADR-236).

enum Workflow {
  LOAD
  HAUL_OUT
  UNIT_RATE

  @@map("workflow")
}

// Displayed COL, DIS, HOC, HOD, URT; labels are never stored in a number (ADR-062, 236).
enum FieldEventKind {
  COLLECTION
  DISPOSAL
  HAUL_OUT_COLLECTION
  HAUL_OUT_DISPOSAL
  UNIT_RATE

  @@map("field_event_kind")
}

enum TicketStatus {
  PENDING
  COMPLETED
  MANUAL_REVIEW
  VOID

  @@map("ticket_status")
}

// Where a record came from: a phone, or a person in the back office (ADR-047, 156).
enum RecordSource {
  DEVICE
  BACK_OFFICE

  @@map("record_source")
}

// How a field event's address was got: looked up from its GPS, or typed (ADR-111).
enum AddressSource {
  LOOKED_UP
  TYPED

  @@map("address_source")
}

// How a tree was measured: what the monitor read, never a conversion (ADR-177).
enum MeasuredAs {
  CIRCUMFERENCE
  DIAMETER

  @@map("measured_as")
}

// What one monitor recorded under a ticket number: one model, five kinds (ADR-236). There is no
// ticket table: a ticket is its number and the field events under it. First the columns every
// kind records (spec/DATA-MODEL.md §4.1 (1)), then the kind-specific ones (§4.1 (2)), each empty
// on every other kind by a check in the guard migration (ADR-325).
model FieldEvent {
  // UUIDv7 made on the phone, so a retried sync is the same record (KD-56): no default here.
  id           String         @id @db.Uuid
  projectId    String         @map("project_id") @db.Uuid
  workflow     Workflow
  kind         FieldEventKind
  // The bare number, as scanned or shown; text, never parsed for meaning (ADR-062).
  ticketNumber String         @map("ticket_number")
  // A, B… on a split load's collections (one per property) and a split haul-out's (one per pile,
  // ADR-295); empty when not split, so the unique key below holds without NULLs (Postgres treats
  // NULLs as distinct). Capital letters, and only on a collection or a haul-out collection (a
  // check, ADR-325).
  splitSuffix  String         @default("") @map("split_suffix")
  // Who witnessed it; never the system actor.
  monitorId    String         @map("monitor_id") @db.Uuid
  // The phone, the assignment it held and the numbered version of its lists the event was
  // captured with, so a reviewer sees what the phone showed (ADR-240). All three on a phone's
  // record, none on one created in the back office (C44; a check in the guard migration).
  deviceId     String?        @map("device_id") @db.Uuid
  assignmentId String?        @map("assignment_id") @db.Uuid
  setupVersion Int?           @map("setup_version")

  // The device's clock, as a UTC instant plus its offset; and when the server received it (ADR-100).
  startedAt              DateTime @map("started_at") @db.Timestamptz(3)
  endedAt                DateTime @map("ended_at") @db.Timestamptz(3)
  deviceUtcOffsetMinutes Int      @map("device_utc_offset_minutes")
  receivedAt             DateTime @default(now()) @map("received_at") @db.Timestamptz(3)

  // WGS84 where the event ended, exact decimals, never floats (invariant 15).
  endLatitude  Decimal? @map("end_latitude") @db.Decimal(38, 8)
  endLongitude Decimal? @map("end_longitude") @db.Decimal(38, 8)

  // A disposal's and a haul-out collection's: a whole-number load call 0-100 (ADR-116). On a split
  // haul-out each pile's is the running call, how full the container is after that pile (ADR-295).
  // Its range and the kinds that may carry it are checks in the guard migrations (BACKLOG 0.3.2).
  loadCall Int? @map("load_call")

  // Reconciliation columns: the only ones the worker may write (ARCHITECTURE §5.1).
  status             TicketStatus @default(PENDING)
  reconciledAt       DateTime?    @map("reconciled_at") @db.Timestamptz(3)
  // The zone attached from the GPS and the map version used, one of its own project's; the zone
  // is one of that version's (ADR-135, 141).
  zoneId             String?      @map("zone_id") @db.Uuid
  mapVersionId       String?      @map("map_version_id") @db.Uuid
  // On a unit rate event: the engine's answer from the bands, one of its own project's pay items.
  // "The phone's answer printed, the engine's bills" (ADR-217).
  workedOutPayItemId String?      @map("worked_out_pay_item_id") @db.Uuid

  // Where it came from. One created in the back office (a phone failed) says who created it and
  // why, picked from the firm's reasons (ADR-156, 173). None of these has a default: whoever
  // writes a field event says.
  source           RecordSource
  createdById      String?      @map("created_by_id") @db.Uuid
  createdReasonId  String?      @map("created_reason_id") @db.Uuid
  // Made under the master passcode's temporary session for this monitor (ADR-120).
  temporarySession Boolean      @map("temporary_session")

  // The number typed instead of scanned, and the reason picked (ADR-111, 173).
  numberTyped         Boolean @map("number_typed")
  numberTypedReasonId String? @map("number_typed_reason_id") @db.Uuid

  // The cert number as scanned off the badge: a snapshot (ADR-017). The certification it found,
  // one of its own project's; empty while no certification on the project has that number
  // (ADR-154). No driver, contractor or capacity is copied here: they are the certification's.
  certNumber      String  @map("cert_number")
  certificationId String? @map("certification_id") @db.Uuid
  // A truck keyed in by hand, with the capacity the monitor read off it: only their claim; the
  // certification's capacity bills (ADR-154).
  certKeyedByHand Boolean @map("cert_keyed_by_hand")
  typedCapacityCy Int?    @map("typed_capacity_cy")

  // The site, from the assignment, never picked; empty on a curb collection and on unit rate
  // work away from a site (ADR-195).
  siteId String? @map("site_id") @db.Uuid

  // WGS84 where the event started: whatever fix the phone had (ADR-083).
  startLatitude  Decimal? @map("start_latitude") @db.Decimal(38, 8)
  startLongitude Decimal? @map("start_longitude") @db.Decimal(38, 8)

  address       String?
  addressSource AddressSource? @map("address_source")
  notes         String?

  // What each kind records (spec/DATA-MODEL.md §4.1 (2)). None is required: a pick that didn't
  // reach the server is a flag's, never a refusal (ADR-325).

  // A load's or a haul-out's debris type, picked at each end on its own (ADR-207): the entry on
  // its own project's form for its workflow, so a rule matches the exact entry (ADR-226). The form
  // and its document type are that entry's, again, and are there exactly when the entry is: they
  // hold it to the field event's project and workflow by foreign keys (ADR-325).
  formDebrisTypeId String?           @map("form_debris_type_id") @db.Uuid
  formId           String?           @map("form_id") @db.Uuid
  formDocumentType FormDocumentType? @map("form_document_type")
  // Optional, one of its own project's: a collection's, a haul-out collection's (it tells a pile),
  // a unit rate event's (ADR-218, 295).
  fieldTagId       String?           @map("field_tag_id") @db.Uuid
  // On an ROE project, a collection's and a unit rate event's: the number as picked or typed, a
  // snapshot like the cert number (ADR-149, 292). The ROE it found is roeId, below.
  roeNumber        String?           @map("roe_number")
  // A split load's property estimate, in CY: there exactly when a collection's split suffix is
  // (ADR-055). A haul-out's piles give a load call instead.
  estimateCy       Decimal?          @map("estimate_cy") @db.Decimal(8, 1)
  // The tower's count on a load that carries tickets (ADR-243).
  carriedCount     Int?              @map("carried_count")

  // A unit rate event's. The kind of work captured (its screen), kept so it is known when no band
  // fits and there is no pay item (ADR-292); the payable type the monitor picked by name
  // (ADR-207); the pay item the phone worked out and printed, one of its own project's, empty when
  // no band fits (ADR-213). The worker's own answer is workedOutPayItemId, above.
  kindOfWorkId        String?     @map("kind_of_work_id") @db.Uuid
  payableTypeId       String?     @map("payable_type_id") @db.Uuid
  payItemId           String?     @map("pay_item_id") @db.Uuid
  // The count or the pounds; nothing where the items hold it (FieldEventItem).
  unitCount           Decimal?    @map("unit_count") @db.Decimal(10, 2)
  // What the monitor read, and whether as a circumference or a diameter: both or neither. A
  // stump's is its diameter two feet up (ADR-177, 189).
  measurementInches   Decimal?    @map("measurement_inches") @db.Decimal(8, 1)
  measuredAs          MeasuredAs? @map("measured_as")
  // Stumps: the root ball's diameter, whether half or more of it is exposed, and the survey number
  // as picked or typed (ADR-198).
  rootBallInches      Decimal?    @map("root_ball_inches") @db.Decimal(8, 1)
  rootBallHalfExposed Boolean?    @map("root_ball_half_exposed")
  surveyNumber        String?     @map("survey_number")
  // Where the pay item lets the monitor mark the work ineligible (ADR-210).
  markedIneligible    Boolean?    @map("marked_ineligible")

  // A disposal's and a haul-out disposal's: the scale receipt it points at, one of its own
  // project's. A tandem's two disposals point at the one receipt; no field event holds a weight of
  // its own (ADR-034, 175).
  scaleReceiptId String? @map("scale_receipt_id") @db.Uuid

  // A collection's and a unit rate event's: the ROE its number found, one of its own project's;
  // empty while no ROE on the project has that number (ADR-292).
  roeId String? @map("roe_id") @db.Uuid

  // A GPS fix that reached the server and couldn't be one (half a fix, a latitude past 90): kept
  // here exactly as the phone sent it, by which end it was, while the field event is saved
  // without that fix (ADR-329 (5), 338). Empty when every fix sent was readable. The flag is the
  // worker's.
  unreadableGps Json? @map("unreadable_gps")

  project            Project             @relation(fields: [projectId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  monitor            User                @relation("FieldEventMonitor", fields: [monitorId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  device             Device?             @relation(fields: [deviceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  assignment         Assignment?         @relation(fields: [assignmentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  createdBy          User?               @relation("FieldEventCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  createdReason      Reason?             @relation("FieldEventCreatedReason", fields: [createdReasonId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  numberTypedReason  Reason?             @relation("FieldEventNumberTypedReason", fields: [numberTypedReasonId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  // One of its own project's certifications, and one of its own project's sites.
  certification      Certification?      @relation(fields: [projectId, certificationId], references: [projectId, id], onDelete: Restrict, onUpdate: Restrict)
  site               DisposalSite?       @relation(fields: [projectId, siteId], references: [projectId, id], onDelete: Restrict, onUpdate: Restrict)
  // Its debris type is an entry of that form, and that form is its own project's.
  form               Form?               @relation(fields: [projectId, formId, formDocumentType], references: [projectId, id, documentType], onDelete: Restrict, onUpdate: Restrict)
  formDebrisType     FormDebrisType?     @relation(fields: [formId, formDebrisTypeId], references: [formId, id], onDelete: Restrict, onUpdate: Restrict)
  fieldTag           FieldTag?           @relation(fields: [projectId, fieldTagId], references: [projectId, id], onDelete: Restrict, onUpdate: Restrict)
  kindOfWork         KindOfWork?         @relation(fields: [kindOfWorkId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  payableType        PayableType?        @relation(fields: [payableTypeId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  payItem            PayItem?            @relation("FieldEventPayItem", fields: [projectId, payItemId], references: [projectId, id], onDelete: Restrict, onUpdate: Restrict)
  mapVersion         MapVersion?         @relation(fields: [projectId, mapVersionId], references: [projectId, id], onDelete: Restrict, onUpdate: Restrict)
  zone               Zone?               @relation(fields: [mapVersionId, zoneId], references: [mapVersionId, id], onDelete: Restrict, onUpdate: Restrict)
  workedOutPayItem   PayItem?            @relation("FieldEventWorkedOutPayItem", fields: [projectId, workedOutPayItemId], references: [projectId, id], onDelete: Restrict, onUpdate: Restrict)
  scaleReceipt       ScaleReceipt?       @relation(fields: [projectId, scaleReceiptId], references: [projectId, id], onDelete: Restrict, onUpdate: Restrict)
  roe                Roe?                @relation(fields: [projectId, roeId], references: [projectId, id], onDelete: Restrict, onUpdate: Restrict)
  items              FieldEventItem[]
  carriedTickets     CarriedTicket[]
  photos             Photo[]
  // The records in quarantine because this field event holds their number (ADR-022).
  quarantinedRecords QuarantinedRecord[]

  // What the worker concluded from it: a disposal's completed record (one: its own unique key),
  // a collection's rows (one live), and the flags about it.
  completedLoads               CompletedLoad[]
  completedLoadCollections     CompletedLoadCollection[]
  completedHaulOuts            CompletedHaulOut[]
  completedHaulOutCollections  CompletedHaulOutCollection[]
  flags                        Flag[]
  // A unit rate ticket's priced lines, and people's marks on it: its QC status and every lock
  // as invoiced it has had, each held to its project and to a unit rate event (marks.prisma).
  transactions                 Transaction[]
  qcMarks                      QcMark[]                     @relation("QcMarkFieldEvent")
  qcMarksAsUnitRateTicket      QcMark[]                     @relation("QcMarkUnitRateTicket")
  invoiceLocks                 InvoiceLock[]                @relation("InvoiceLockFieldEvent")
  invoiceLocksAsUnitRateTicket InvoiceLock[]                @relation("InvoiceLockUnitRateTicket")

  // One field event per project + workflow + bare number + split suffix + kind (ARCHITECTURE §5.4).
  @@unique([projectId, workflow, ticketNumber, splitSuffix, kind])
  // What an item line and a carried ticket point at, so each is held to the kind it belongs on.
  @@unique([id, kind])
  // What a photograph points at, so it is one of its own project's field events.
  @@unique([projectId, id])
  // So a viewer's "who recorded it" is found by the monitor.
  @@index([monitorId])
  @@map("field_event")
}

// One line of an itemised unit rate event: an item from the firm's list with its count, or its
// hours to the quarter hour (ADR-040, 084). An item appears once on a ticket; a line is never a
// pay item and holds no price.
model FieldEventItem {
  id             String         @id @default(dbgenerated("uuidv7()")) @db.Uuid
  fieldEventId   String         @map("field_event_id") @db.Uuid
  // Its field event's, again: UNIT_RATE, held by a check and by the relation (ADR-325).
  fieldEventKind FieldEventKind @map("field_event_kind")
  itemNameId     String         @map("item_name_id") @db.Uuid
  quantity       Decimal        @db.Decimal(10, 2)

  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  // Taken off by a correction: a mark with its time, cleared to put the line back. The row
  // stays; a line taken off counts for nothing (ADR-364).
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(3)

  fieldEvent FieldEvent @relation(fields: [fieldEventId, fieldEventKind], references: [id, kind], onDelete: Restrict, onUpdate: Restrict)
  itemName   ItemName   @relation(fields: [itemNameId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([fieldEventId, itemNameId])
  @@map("field_event_item")
}

// A ticket a load carries: a stump's or a white goods ticket's number, as the loading monitor
// added it (ADR-192). The number as written, never a link: one that matches no ticket is taken
// and flagged later.
model CarriedTicket {
  id                  String         @id @default(dbgenerated("uuidv7()")) @db.Uuid
  fieldEventId        String         @map("field_event_id") @db.Uuid
  // Its field event's, again: COLLECTION, held by a check and by the relation (ADR-325).
  fieldEventKind      FieldEventKind @map("field_event_kind")
  carriedTicketNumber String         @map("carried_ticket_number")

  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  // Taken off by a correction: a mark with its time, cleared to put the ticket back. The row
  // stays; a carried ticket taken off counts for nothing (ADR-364).
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(3)

  fieldEvent FieldEvent @relation(fields: [fieldEventId, fieldEventKind], references: [id, kind], onDelete: Restrict, onUpdate: Restrict)

  @@unique([fieldEventId, carriedTicketNumber])
  @@map("carried_ticket")
}

// The paper a final disposal site hands the tower: its own record, apart from any ticket, pointed
// at by one or several disposals (a tandem weighed once) and consumed once (ADR-034, 038). Every
// figure is what the paper says, copied by hand: none is worked out from another, and a
// receipt-book slip has none. A tandem's shares are derived, on the completed loads, never here
// (ADR-175).
model ScaleReceipt {
  // UUIDv7 made on the phone, so a retried sync is the same record (KD-56): no default here.
  id            String @id @db.Uuid
  projectId     String @map("project_id") @db.Uuid
  // The site's own number, exactly as written: never one of ours, never a ticket number, never
  // put into our format (ADR-034).
  receiptNumber String @map("receipt_number")
  // The site that issued it, one of its own project's.
  siteId        String @map("site_id") @db.Uuid

  grossWeightLb Decimal? @map("gross_weight_lb") @db.Decimal(12, 2)
  tareWeightLb  Decimal? @map("tare_weight_lb") @db.Decimal(12, 2)
  netWeightLb   Decimal? @map("net_weight_lb") @db.Decimal(12, 2)
  netWeightTons Decimal? @map("net_weight_tons") @db.Decimal(12, 4)

  // The monitor making the ticket at the disposal (ADR-294); never the system actor. The phone,
  // where one was used.
  enteredById            String   @map("entered_by_id") @db.Uuid
  deviceId               String?  @map("device_id") @db.Uuid
  // The device's clock, as a UTC instant plus its offset; and when the server received it (ADR-100).
  enteredAt              DateTime @map("entered_at") @db.Timestamptz(3)
  deviceUtcOffsetMinutes Int      @map("device_utc_offset_minutes")
  receivedAt             DateTime @default(now()) @map("received_at") @db.Timestamptz(3)

  notes String?

  project     Project      @relation(fields: [projectId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  site        DisposalSite @relation(fields: [projectId, siteId], references: [projectId, id], onDelete: Restrict, onUpdate: Restrict)
  enteredBy   User         @relation(fields: [enteredById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  device      Device?      @relation(fields: [deviceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  fieldEvents FieldEvent[]
  photos      Photo[]

  // The number is never unique (ADR-328): a site's receipt book starts again at 001. A duplicate
  // record (the same truck, day and time) is the worker's to flag.
  // What a disposal and a photograph point at, so each is its own project's.
  @@unique([projectId, id])
  @@map("scale_receipt")
}

// A certification's five views (ADR-179).
enum PhotoView {
  OPERATOR_WITH_PLACARD
  INTERIOR_OR_BACK
  RIGHT
  LEFT
  FRONT

  @@map("photo_view")
}

// A photograph's record: the file itself is one object in storage, never overwritten, kept
// indefinitely (ADR-101; ARCHITECTURE §11). It belongs to exactly one thing, one of its own
// project's (a check in the guard migration): a field event, a certification, a scale receipt, an
// ROE, a survey, an incident, a drop-off log, or a record while it waits in quarantine (ADR-292,
// 338). How many a ticket may hold is the phone's rule, never the database's.
model Photo {
  // UUIDv7 made on the phone, so a retried sync is the same record (KD-56): no default here.
  id                  String  @id @db.Uuid
  projectId           String  @map("project_id") @db.Uuid
  fieldEventId        String? @map("field_event_id") @db.Uuid
  certificationId     String? @map("certification_id") @db.Uuid
  scaleReceiptId      String? @map("scale_receipt_id") @db.Uuid
  roeId               String? @map("roe_id") @db.Uuid
  surveyId            String? @map("survey_id") @db.Uuid
  incidentId          String? @map("incident_id") @db.Uuid
  dropOffLogId        String? @map("drop_off_log_id") @db.Uuid
  // While its record waits in quarantine; a reviewer's resolution moves the photograph to the
  // field event the record becomes (ADR-292 (5); BACKLOG 1.8.x).
  quarantinedRecordId String? @map("quarantined_record_id") @db.Uuid

  // Which of the five views a certification's photograph is; no other photograph has one.
  view PhotoView?

  // The device's clock, as a UTC instant plus its offset; and when the server received the record
  // (ADR-100).
  capturedAt             DateTime @map("captured_at") @db.Timestamptz(3)
  deviceUtcOffsetMinutes Int      @map("device_utc_offset_minutes")
  receivedAt             DateTime @default(now()) @map("received_at") @db.Timestamptz(3)

  // WGS84 where it was taken: whatever fix the phone had (invariant 15).
  latitude  Decimal? @db.Decimal(38, 8)
  longitude Decimal? @db.Decimal(38, 8)

  // The fingerprint taken at capture and the fingerprint of the file uploaded, so anyone can show
  // the one came from the other; where the file is, and the depth data beside it where it couldn't
  // travel inside. None of the four is ever changed (a trigger in the guard migration).
  originalSha256 String  @map("original_sha256")
  uploadedSha256 String  @map("uploaded_sha256")
  objectKey      String  @unique @map("object_key")
  depthObjectKey String? @unique @map("depth_object_key")

  deviceId   String?   @map("device_id") @db.Uuid
  // When the file reached storage; empty until it has.
  uploadedAt DateTime? @map("uploaded_at") @db.Timestamptz(3)

  // The back office's two marks (ADR-329 (9), 337). Removed from the record: an archive mark, set
  // when it was removed and cleared to put it back; the record, the file and its fingerprints
  // stay, and who removed it is the audit record's actor. And a label: the firm's own words for
  // what the photograph shows, read by no check.
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(3)
  label      String?

  project           Project            @relation(fields: [projectId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  fieldEvent        FieldEvent?        @relation(fields: [projectId, fieldEventId], references: [projectId, id], onDelete: Restrict, onUpdate: Restrict)
  certification     Certification?     @relation(fields: [projectId, certificationId], references: [projectId, id], onDelete: Restrict, onUpdate: Restrict)
  scaleReceipt      ScaleReceipt?      @relation(fields: [projectId, scaleReceiptId], references: [projectId, id], onDelete: Restrict, onUpdate: Restrict)
  roe               Roe?               @relation(fields: [projectId, roeId], references: [projectId, id], onDelete: Restrict, onUpdate: Restrict)
  survey            Survey?            @relation(fields: [projectId, surveyId], references: [projectId, id], onDelete: Restrict, onUpdate: Restrict)
  incident          Incident?          @relation(fields: [projectId, incidentId], references: [projectId, id], onDelete: Restrict, onUpdate: Restrict)
  dropOffLog        DropOffLog?        @relation(fields: [projectId, dropOffLogId], references: [projectId, id], onDelete: Restrict, onUpdate: Restrict)
  quarantinedRecord QuarantinedRecord? @relation(fields: [projectId, quarantinedRecordId], references: [projectId, id], onDelete: Restrict, onUpdate: Restrict)
  device            Device?            @relation(fields: [deviceId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@map("photo")
}

// Forms: records, never a ticket's field events (ADR-236). A survey, an incident and a drop-off
// log never pair, never bill and have no status; each is QC'd on its own (ADR-107). Each says
// where it came from as a field event does: a phone's carries its phone, assignment and setup
// version; one created in the back office the person and the reason (ADR-047, 156; a check in the
// guard migration). Each keeps the firm's own fields as answers keyed by field id, with the
// version of the definition they answered, one of its own project's form of its kind (ADR-278).

// A property's condition before work, or after it: its work type from the firm's list, the survey
// number as written and its ROE (ADR-149, 150).
model Survey {
  // Made on the phone, so a retried sync is the same record (KD-56); by the database for one
  // created in the back office.
  id              String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  projectId       String       @map("project_id") @db.Uuid
  source          RecordSource
  // Who made it; never the system actor.
  monitorId       String       @map("monitor_id") @db.Uuid
  deviceId        String?      @map("device_id") @db.Uuid
  assignmentId    String?      @map("assignment_id") @db.Uuid
  setupVersion    Int?         @map("setup_version")
  createdById     String?      @map("created_by_id") @db.Uuid
  createdReasonId String?      @map("created_reason_id") @db.Uuid

  // The device's clock, as a UTC instant plus its offset; and when the server received it (ADR-100).
  madeAt                 DateTime @map("made_at") @db.Timestamptz(3)
  deviceUtcOffsetMinutes Int      @map("device_utc_offset_minutes")
  receivedAt             DateTime @default(now()) @map("received_at") @db.Timestamptz(3)

  // WGS84, exact decimals: whatever fix the phone had (invariant 15).
  latitude  Decimal? @db.Decimal(38, 8)
  longitude Decimal? @db.Decimal(38, 8)

  answers          Json
  formDefinitionId String?           @map("form_definition_id") @db.Uuid
  formId           String?           @map("form_id") @db.Uuid
  formDocumentType FormDocumentType? @map("form_document_type")
  notes            String?

  workTypeId   String  @map("work_type_id") @db.Uuid
  // What a stump ticket cites (ADR-198). Typed as written, never issued by the system: usually
  // what names the property legally. No series, and not unique: a property's pre-work and
  // post-work surveys carry the same one (ADR-294).
  surveyNumber String? @map("survey_number")
  // The ROE's number as picked or typed, a snapshot (ADR-292); and the ROE it found, one of its
  // own project's, empty while no ROE on the project has that number. A post-work survey finds
  // its pre-work survey by the ROE number (ADR-150).
  roeNumber    String? @map("roe_number")
  roeId        String? @map("roe_id") @db.Uuid

  project        Project         @relation(fields: [projectId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  monitor        User            @relation("SurveyMonitor", fields: [monitorId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  device         Device?         @relation(fields: [deviceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  assignment     Assignment?     @relation(fields: [assignmentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  createdBy      User?           @relation("SurveyCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  createdReason  Reason?         @relation(fields: [createdReasonId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  form           Form?           @relation(fields: [projectId, formId, formDocumentType], references: [projectId, id, documentType], onDelete: Restrict, onUpdate: Restrict)
  formDefinition FormDefinition? @relation(fields: [formId, formDefinitionId], references: [formId, id], onDelete: Restrict, onUpdate: Restrict)
  workType       SurveyWorkType  @relation(fields: [workTypeId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  roe            Roe?            @relation(fields: [projectId, roeId], references: [projectId, id], onDelete: Restrict, onUpdate: Restrict)
  photos         Photo[]
  // The flags about it (a post-work survey with no pre-work one).
  flags          Flag[]
  // The back office's QC status of it, a mark of its own (marks.prisma).
  qcMarks        QcMark[]

  // What a photograph points at, so it is one of its own project's surveys.
  @@unique([projectId, id])
  // So a post-work survey's pre-work survey is found by the ROE number.
  @@index([projectId, roeNumber])
  @@map("survey")
}

// Something that happened in the field. Records only: it never stops work, whatever the incident
// (ADR-052). It has no ticket number. It may name the contractor involved, a certification by its
// cert number and an ROE by its number, each optional (ADR-328); which of them a monitor is
// offered is the project's incident form's to say, never a refusal here.
model Incident {
  // Made on the phone, so a retried sync is the same record (KD-56); by the database for one
  // created in the back office.
  id              String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  projectId       String       @map("project_id") @db.Uuid
  source          RecordSource
  // Who made it; never the system actor.
  monitorId       String       @map("monitor_id") @db.Uuid
  deviceId        String?      @map("device_id") @db.Uuid
  assignmentId    String?      @map("assignment_id") @db.Uuid
  setupVersion    Int?         @map("setup_version")
  createdById     String?      @map("created_by_id") @db.Uuid
  createdReasonId String?      @map("created_reason_id") @db.Uuid

  // The device's clock, as a UTC instant plus its offset; and when the server received it (ADR-100).
  madeAt                 DateTime @map("made_at") @db.Timestamptz(3)
  deviceUtcOffsetMinutes Int      @map("device_utc_offset_minutes")
  receivedAt             DateTime @default(now()) @map("received_at") @db.Timestamptz(3)

  // WGS84, exact decimals: whatever fix the phone had (invariant 15).
  latitude  Decimal? @db.Decimal(38, 8)
  longitude Decimal? @db.Decimal(38, 8)

  answers          Json
  formDefinitionId String?           @map("form_definition_id") @db.Uuid
  formId           String?           @map("form_id") @db.Uuid
  formDocumentType FormDocumentType? @map("form_document_type")
  notes            String?

  // Picked from the firm's lists: a type, then a sub-type (ADR-137).
  incidentTypeId    String  @map("incident_type_id") @db.Uuid
  incidentSubTypeId String? @map("incident_sub_type_id") @db.Uuid
  description       String?
  parties           String?
  address           String?

  // The contractor involved, picked from those on its own project, a prime or a sub (ADR-328).
  contractorId    String? @map("contractor_id") @db.Uuid
  // The cert number as scanned or typed, a snapshot as on a field event, and the certification it
  // found, one of its own project's; empty while no certification on the project has that number.
  certNumber      String? @map("cert_number")
  certificationId String? @map("certification_id") @db.Uuid
  // The ROE's number as picked or typed, a snapshot, and the ROE it found, one of its own
  // project's; empty while no ROE on the project has that number (ADR-292).
  roeNumber       String? @map("roe_number")
  roeId           String? @map("roe_id") @db.Uuid

  project         Project            @relation(fields: [projectId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  monitor         User               @relation("IncidentMonitor", fields: [monitorId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  device          Device?            @relation(fields: [deviceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  assignment      Assignment?        @relation(fields: [assignmentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  createdBy       User?              @relation("IncidentCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  createdReason   Reason?            @relation(fields: [createdReasonId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  form            Form?              @relation(fields: [projectId, formId, formDocumentType], references: [projectId, id, documentType], onDelete: Restrict, onUpdate: Restrict)
  formDefinition  FormDefinition?    @relation(fields: [formId, formDefinitionId], references: [formId, id], onDelete: Restrict, onUpdate: Restrict)
  incidentType    IncidentType       @relation(fields: [incidentTypeId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  incidentSubType IncidentSubType?   @relation(fields: [incidentSubTypeId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  contractor      ProjectContractor? @relation(fields: [projectId, contractorId], references: [projectId, contractorId], onDelete: Restrict, onUpdate: Restrict)
  certification   Certification?     @relation(fields: [projectId, certificationId], references: [projectId, id], onDelete: Restrict, onUpdate: Restrict)
  roe             Roe?               @relation(fields: [projectId, roeId], references: [projectId, id], onDelete: Restrict, onUpdate: Restrict)
  photos          Photo[]
  // The back office's QC status of it, a mark of its own (marks.prisma).
  qcMarks         QcMark[]

  // What a photograph points at, so it is one of its own project's incidents.
  @@unique([projectId, id])
  @@map("incident")
}

// A citizen's drop-off at a site: a reference log, like an incident, never a ticket. No quantity,
// number, pay item or cost; the pile bills when it leaves on a haul-out (ADR-184, 188). Not
// checked against the site's facts (ADR-215).
model DropOffLog {
  // Made on the phone, so a retried sync is the same record (KD-56); by the database for one
  // created in the back office.
  id              String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  projectId       String       @map("project_id") @db.Uuid
  source          RecordSource
  // Who made it; never the system actor.
  monitorId       String       @map("monitor_id") @db.Uuid
  deviceId        String?      @map("device_id") @db.Uuid
  assignmentId    String?      @map("assignment_id") @db.Uuid
  setupVersion    Int?         @map("setup_version")
  createdById     String?      @map("created_by_id") @db.Uuid
  createdReasonId String?      @map("created_reason_id") @db.Uuid

  // The device's clock, as a UTC instant plus its offset; and when the server received it (ADR-100).
  madeAt                 DateTime @map("made_at") @db.Timestamptz(3)
  deviceUtcOffsetMinutes Int      @map("device_utc_offset_minutes")
  receivedAt             DateTime @default(now()) @map("received_at") @db.Timestamptz(3)

  // WGS84, exact decimals: whatever fix the phone had (invariant 15).
  latitude  Decimal? @db.Decimal(38, 8)
  longitude Decimal? @db.Decimal(38, 8)

  answers          Json
  formDefinitionId String?           @map("form_definition_id") @db.Uuid
  formId           String?           @map("form_id") @db.Uuid
  formDocumentType FormDocumentType? @map("form_document_type")
  notes            String?

  // The site, one of its own project's; the resident's name and where the debris came from, only
  // if given.
  siteId        String  @map("site_id") @db.Uuid
  residentName  String? @map("resident_name")
  originAddress String? @map("origin_address")

  project        Project         @relation(fields: [projectId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  monitor        User            @relation("DropOffLogMonitor", fields: [monitorId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  device         Device?         @relation(fields: [deviceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  assignment     Assignment?     @relation(fields: [assignmentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  createdBy      User?           @relation("DropOffLogCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  createdReason  Reason?         @relation(fields: [createdReasonId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  form           Form?           @relation(fields: [projectId, formId, formDocumentType], references: [projectId, id, documentType], onDelete: Restrict, onUpdate: Restrict)
  formDefinition FormDefinition? @relation(fields: [formId, formDefinitionId], references: [formId, id], onDelete: Restrict, onUpdate: Restrict)
  site           DisposalSite    @relation(fields: [projectId, siteId], references: [projectId, id], onDelete: Restrict, onUpdate: Restrict)
  photos         Photo[]
  // The back office's QC status of it, a mark of its own (marks.prisma).
  qcMarks        QcMark[]

  // What a photograph points at, so it is one of its own project's drop-off logs.
  @@unique([projectId, id])
  @@map("drop_off_log")
}

// Why a record a phone sent is in quarantine and not saved: the number it carries is held by
// another record (ADR-022, 338).
enum QuarantineReason {
  // A second field event of one kind on one ticket (project, workflow, bare number, split suffix).
  DUPLICATE_FIELD_EVENT
  // An ROE made on a phone whose number another ROE of the project already has.
  DUPLICATE_ROE_NUMBER

  @@map("quarantine_reason")
}

// A record a phone sent that couldn't be saved because another record holds its number, kept in
// full for a person (ADR-022, 292; adms-exceptions §4.3a). It is no ticket's field event: the
// worker never reads it, it has no status and it bills nothing. What the phone sent is never
// changed; a reviewer's resolution is written beside it, and the row is kept (BACKLOG 1.8.x).
model QuarantinedRecord {
  // The id the phone made for the record, so a retried sync is the same quarantined record
  // (KD-56), and the record keeps it when a reviewer resolves it: no default here.
  id        String @id @db.Uuid
  projectId String @map("project_id") @db.Uuid
  deviceId  String @map("device_id") @db.Uuid
  // Who made the record; never the system actor.
  monitorId String @map("monitor_id") @db.Uuid

  // The record exactly as the phone sent it, for a person to read.
  payload        Json
  reason         QuarantineReason
  // The record that holds the number, one of its own project's: a field event, or an ROE.
  holdingEventId String?          @map("holding_event_id") @db.Uuid
  holdingRoeId   String?          @map("holding_roe_id") @db.Uuid
  // When the server received it (ADR-100).
  receivedAt     DateTime         @default(now()) @map("received_at") @db.Timestamptz(3)

  // Who resolved it, when, and what they did: all three or none.
  resolvedById String?   @map("resolved_by_id") @db.Uuid
  resolvedAt   DateTime? @map("resolved_at") @db.Timestamptz(3)
  resolution   String?

  project      Project     @relation(fields: [projectId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  device       Device      @relation(fields: [deviceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  monitor      User        @relation("QuarantinedRecordMonitor", fields: [monitorId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  resolvedBy   User?       @relation("QuarantinedRecordResolvedBy", fields: [resolvedById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  holdingEvent FieldEvent? @relation(fields: [projectId, holdingEventId], references: [projectId, id], onDelete: Restrict, onUpdate: Restrict)
  holdingRoe   Roe?        @relation(fields: [projectId, holdingRoeId], references: [projectId, id], onDelete: Restrict, onUpdate: Restrict)
  photos       Photo[]

  // What a photograph points at, so it is one of its own project's quarantined records.
  @@unique([projectId, id])
  @@map("quarantined_record")
}

// A numbered version of a project's setup as its phones are shown it (ARCHITECTURE §7's note,
// §9 (6); ADR-240, 453): the lists a phone picks from, whole for the project, so a reviewer sees
// what a phone showed when a field event recorded that version. Made when a phone is first sent
// lists that differ from the newest version's; numbered 1, 2, 3… per project by the database's
// own rule; never changed and never deleted. Never a rate, a rule or a load's pay item: a phone
// is shown none. Certifications and ROEs are records with their own history, and are in none.
model SetupManifest {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  projectId String   @map("project_id") @db.Uuid
  version   Int
  // The setup as sent, for a person to read.
  content   Json
  builtAt   DateTime @default(now()) @map("built_at") @db.Timestamptz(3)

  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([projectId, version])
  @@map("setup_manifest")
}

// One sync from a phone: the server's own record that the phone connected, when, and how far its
// clock stood from the server's (ARCHITECTURE §9 (1), §10; ADR-100, 467, 471). Written when the
// sync begins, for the phone that proved itself, and never changed after, but for the setup
// version its answer carried, written once. The records it brought name it; the worker reads
// the difference to flag their tickets. Never deleted.
model Sync {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  deviceId  String   @map("device_id") @db.Uuid
  // The server's clock when the sync began.
  startedAt DateTime @default(now()) @map("started_at") @db.Timestamptz(3)

  // The phone's clock as it sent the sync, a UTC instant, and how far that clock stood from UTC.
  deviceClockAt          DateTime @map("device_clock_at") @db.Timestamptz(3)
  deviceUtcOffsetMinutes Int      @map("device_utc_offset_minutes")
  // The phone's clock less the server's, in whole seconds: above nought when the phone's is
  // ahead. A phone may report any instant, so it is kept wide.
  clockDifferenceSeconds BigInt   @map("clock_difference_seconds")
  // The setup version the phone was sent in this sync's answer, where it was sent one.
  setupVersionSent       Int?     @map("setup_version_sent")

  device        Device         @relation(fields: [deviceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  syncedRecords SyncedRecord[]
  heldRecords   HeldRecord[]

  // What a synced or a held record points at, so the phone it states is its sync's.
  @@unique([id, deviceId])
  @@map("sync")
}

// What the server answered a record it stored (ARCHITECTURE §9 (4); AC-05-16). A record it could
// not store is a held record, and is not in this ledger (ADR-468, 471).
enum SyncAnswer {
  SAVED
  QUARANTINED

  @@map("sync_answer")
}

// The idempotency ledger (ARCHITECTURE §9 (3); KD-56; ADR-471): one row for each record the
// server stored, as a record of its kind or in quarantine, keyed on the id its phone made, with
// the sync that brought it and the answer it was given. A retry is known from here and never
// taken for a duplicate ticket number. Written once, never changed, never deleted.
model SyncedRecord {
  // The id the phone made for the record: no default here. The column is `id`, as every
  // table's key is: the audit log names a row by it.
  recordId   String     @id @map("id") @db.Uuid
  // The contract's word for the kind of record (`FIELD_EVENT`, `ROE`…).
  recordKind String     @map("record_kind")
  syncId     String     @map("sync_id") @db.Uuid
  deviceId   String     @map("device_id") @db.Uuid
  answer     SyncAnswer

  sync Sync @relation(fields: [syncId, deviceId], references: [id, deviceId], onDelete: Restrict, onUpdate: Restrict)

  @@map("synced_record")
}

// Why a record a phone sent was not saved (ADR-467, 469): the domain's `notSavedReasons`.
enum NotSavedReason {
  // What was sent fails the contract's schema.
  NOT_A_RECORD
  // The database's own constraints refuse what it names.
  NAMES_NO_RECORD
  // The unplanned assignment it was made under was not saved.
  ASSIGNMENT_NOT_SAVED
  // A certification its own rules refuse, or whose number its project already has.
  CERTIFICATION_REFUSED

  @@map("not_saved_reason")
}

// A record a phone sent that the server could not save, held exactly as sent for a person
// (ADR-468, 471). Inert: never a field event, never paired, never billed, never read by the
// worker. The phone is known for certain, from its proof; the project and the monitor are only
// what the record said, and may name nothing, so neither is a relation. The same thing sent
// again by the same phone is the same held record. What was sent is never changed and never
// deleted; only its resolution is written later, by a person.
model HeldRecord {
  id       String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  deviceId String @map("device_id") @db.Uuid
  syncId   String @map("sync_id") @db.Uuid

  // As sent, where that much could be read: the record's own id, its project and its monitor.
  sentId        String? @map("sent_id") @db.Uuid
  projectId     String? @map("project_id") @db.Uuid
  sentMonitorId String? @map("sent_monitor_id") @db.Uuid

  // What stood in the record's place, exactly as sent: any JSON value.
  payload    Json
  // The SHA-256 of what was sent, so a retry is the same held record.
  sentSha256 String         @map("sent_sha256")
  reason     NotSavedReason
  // What the phone was told.
  message    String
  // When the server received it (ADR-100).
  receivedAt DateTime       @default(now()) @map("received_at") @db.Timestamptz(3)

  // Who resolved it, when, and what they did: all three or none.
  resolvedById String?   @map("resolved_by_id") @db.Uuid
  resolvedAt   DateTime? @map("resolved_at") @db.Timestamptz(3)
  resolution   String?

  sync       Sync  @relation(fields: [syncId, deviceId], references: [id, deviceId], onDelete: Restrict, onUpdate: Restrict)
  resolvedBy User? @relation("HeldRecordResolvedBy", fields: [resolvedById], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([deviceId, sentSha256])
  @@map("held_record")
}
