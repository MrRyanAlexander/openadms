# Open ADMS policy values: the built-in defaults (invariant 16; ADR-303).
#
# A threshold is policy, never a number in code. These are the values a release ships with: what a
# new project's settings start as, before the firm changes them on the project (audited). The names
# are packages/domain's (src/policy.ts), which refuses a value that is missing or out of range.
# No secret belongs in this file: it is committed.

# A load call at or under the low limit, or at or over the high limit, is flagged (ADR-164).
# A project may change either, or switch them off; a 0% load call is flagged either way (ADR-181).
LOAD_CALL_LOW_LIMIT=5
LOAD_CALL_HIGH_LIMIT=95

# The circle round a disposal site's GPS, in metres, for a site without its own shape (ADR-142).
# A project changes it in its GIS settings.
DISPOSAL_SITE_PROXIMITY_M=200

# The root-ball height the stump fill is worked out with, in inches: the USACE Stump Conversion
# Guide's (ADR-183, 203). A project changes it for a contract that says otherwise.
STUMP_FILL_DEPTH_INCHES=31

# A crew day's length, in hours, on a pay item that pays crew time by the crew day by exact
# division: the hours ÷ this (ADR-087, 309). The firm changes it on the pay item.
CREW_DAY_HOURS=12

# How many unused numbers a phone holds after a top-up at a sync: ticket numbers on a phone that
# makes them (ADR-065), cert numbers on a certifying phone (ADR-181), ROE numbers (ADR-323). A
# phone gives its block out in order, offline; gaps in a series are normal.
TICKET_NUMBER_BLOCK_SIZE=1000
CERT_NUMBER_BLOCK_SIZE=100
ROE_NUMBER_BLOCK_SIZE=100

# The largest body the API reads from one request, in bytes (ARCHITECTURE §6, Input; ADR-389): one
# mebibyte. A request that says it is larger, or turns out to be, is refused before it is read
# whole. An endpoint that must take more (a photograph) states its own limit with its task.
REQUEST_BODY_LIMIT_BYTES=1048576

# How long one statement of a service's database login may run, in milliseconds, before the
# database stops it (ARCHITECTURE §5.7; ADR-394): thirty seconds. `pnpm installer` sets it on the
# API's, the worker's and the read-only login, never on the owner's (migrations). A wait for a
# lock counts. A service's own env file may state another for its logins (ADR-395).
STATEMENT_TIMEOUT_MS=30000

# The most connections one service's pool opens to the database (ARCHITECTURE §5.7; ADR-419): ten
# for the API and ten for the worker, each by its own login. Never under two: a run of the worker
# holds its project's lock on one connection and writes on another. A service's own env file may
# state another (ADR-395); the database's own max_connections must hold them all.
DATABASE_POOL_CONNECTIONS=10

# The shortest password a back-office or outside user may set, in characters, each Unicode code
# point counted as one (ARCHITECTURE §6, Passwords; NIST SP 800-63B-4 §3.1.1.2; ADR-402): fifteen,
# what the standard asks where a password may be the only thing a person signs in with (a
# read-only viewer's second step is optional, ADR-170). Never under eight. A monitor's password is
# exempt (ADR-105). The longest is far over the 64 the standard says must be permitted.
PASSWORD_MINIMUM_LENGTH=15
PASSWORD_MAXIMUM_LENGTH=128

# How long a password reset sent by email stays good, in minutes (ADR-404): one hour. The standard
# allows a day at most (NIST SP 800-63B-4 §4.2). It is spent the moment the password changes.
PASSWORD_RESET_MINUTES=60

# A back-office or outside user's session (ARCHITECTURE §6, Back-office sessions; ADR-408). The
# access token is good for five minutes; the page gets a new one with its refresh token. A session
# nobody asks anything of ends after thirty minutes, and every session ends twelve hours after
# its sign-in, whatever is asked of it. NIST SP 800-63B-4 §2.2.3 says no more than an hour and no
# more than a day where a second step is required, and the ranges stop there.
ACCESS_TOKEN_MINUTES=5
SESSION_INACTIVITY_MINUTES=30
SESSION_OVERALL_HOURS=12

# Wrong tries at one login (ARCHITECTURE §6, Abuse; NIST SP 800-63B-4 §3.2.2; ADR-409). After five
# in a row the login waits before it may be tried again: thirty seconds, then twice as long after
# each further wrong try, an hour at the most (from the twelfth). After fifty in a row it is
# locked until its password is set anew (a reset by email, or an admin). The standard's limit is
# a hundred. Fifty, not fewer (the user, ADR-417): a lock anybody's wrong tries can cause keeps
# the real person out, so it comes late, and the waits and the limits by address do the work
# before it. The number before a wait is that of a phone's own sign-in screen (ARCHITECTURE §7.2).
SIGN_IN_TRIES_BEFORE_WAIT=5
SIGN_IN_TRIES_BEFORE_LOCK=50
SIGN_IN_FIRST_WAIT_SECONDS=30
SIGN_IN_LONGEST_WAIT_MINUTES=60

# Two-step sign-in (ARCHITECTURE §6; ADR-170, 412). An authenticator app shows a new six-digit
# code every thirty seconds. The server takes in the code of its own thirty seconds and of this
# many steps before and after it: one, for a phone's clock that runs a little off and the time it
# takes to type (NIST SP 800-63B-4 §3.1.4.2; RFC 6238 §5.2). Nought takes the server's own step
# alone, the strictest reading of ASVS 6.5.5's thirty seconds. Never more than one. A code is
# good once whatever this says. Setting an authenticator up must be finished within ten minutes.
TWO_STEP_CODE_STEPS_EITHER_SIDE=1
TWO_STEP_SETUP_MINUTES=10

# A phone's proof of itself (ARCHITECTURE §7.4; NIST SP 800-63B-4 §3.1.6.2; ADR-437). Before a
# sync the server makes the phone a challenge, and the phone signs it with its device key. The
# challenge may be sent back signed for two minutes: long enough for a weak connection at the
# edge of signal, short enough that one left lying is soon worth nothing. A challenge is good
# once whatever this says.
PHONE_CHALLENGE_SECONDS=120

# What a proof gives (NIST SP 800-63B-4 §5.1; ADR-440): a token for that phone, which the calls
# of its sync carry. It is good for fifteen minutes: long enough for a sync's records and a
# slow photograph or two, short enough that one taken off the wire is soon worth nothing. A
# phone proves itself again for another, at any time; a phone whose key is revoked is refused
# at once, whatever its token says.
PHONE_TOKEN_MINUTES=15

# A monitor's sign-in on a phone (ARCHITECTURE §6, Device sessions; §7.2; ADR-441 (6), 443). It
# lasts a shift: twelve hours after the monitor signed in, and it doesn't end for quiet, since a
# phone is out of signal most of the day and its sync must not need the monitor back at the
# screen (the phone's own lock after inactivity is the field app's). NIST SP 800-63B-4 §2.2.3
# allows a day at most, and the range stops there.
MONITOR_SESSION_HOURS=12

# A phone's login list (ARCHITECTURE §7.2; ADR-449, 454). Each entry is a slow hash the server
# makes for that phone and monitor: about a hundredth of a second of a processor each, measured
# 2026-10-09, so a project of three hundred monitors is some four seconds for a phone that holds
# none. The server makes at most this many in one call and says there are more; the phone asks
# again, saying what it now holds. Entries a phone already holds are never made again.
LOGIN_LIST_ENTRIES_PER_CALL=50

# An address looked up for a phone's GPS (ARCHITECTURE §3; AC-04-24; ADR-455). The API asks our
# own address server and a monitor waits at the curb for the answer, so the address server has
# five seconds to give it: one that doesn't is answered "no answer" and the monitor types the
# street number and name, as with no connection. Never the worker's thirty seconds below: no
# person waits on those.
ADDRESS_LOOKUP_ANSWER_SECONDS=5

# Rate limits on every request (ARCHITECTURE §6, Abuse; OWASP ASVS 5.0 2.4.1; ADR-416). Requests
# are counted over a minute. One address may send three thousand in it (fifty a second): a firm's
# whole office, and its phones on the office's network, usually reach the server from one address.
# One signed-in person may send six hundred, from whatever address. A caller over a limit is
# answered 429 LIMITED and told how many seconds to wait. The server keeps the counts in its own
# memory, a hundred thousand callers' at once; past that the oldest goes.
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_REQUESTS_PER_ADDRESS=3000
RATE_LIMIT_REQUESTS_PER_ACCOUNT=600
RATE_LIMIT_COUNTS_KEPT=100000

# Tries at sign-in from one address (ASVS 6.1.1, 6.3.1; NIST SP 800-63B-4 §3.2.2; ADR-416),
# counted over an hour. One address may be refused thirty times, whoever's login it tried: a
# sign-in, a reset's code, a current password, an authenticator's code. At one login it may be
# refused four times: fewer than put a wait on the login (SIGN_IN_TRIES_BEFORE_WAIT, and always
# under it), so a stranger at one address is stopped before the login's own count is spent, and a
# try stopped here never counts against the login. A sign-in that works from that address, or the
# login's password set anew, starts that count again. One address may ask for ten resets by
# email, and three may be asked for one login, whoever asks.
SIGN_IN_ADDRESS_WINDOW_MINUTES=60
SIGN_IN_WRONG_TRIES_PER_ADDRESS=30
SIGN_IN_WRONG_TRIES_PER_ADDRESS_AT_LOGIN=4
PASSWORD_RESET_ASKS_PER_ADDRESS=10
PASSWORD_RESET_ASKS_PER_LOGIN=3

# The worker (ARCHITECTURE §13; ADR-418, 419), read by the worker's process alone; its own env
# file (apps/worker/.env) may state another (ADR-395). A job that fails whole (the process died,
# the database was away, the run's time ran out) is taken up again by its project's next run, and
# set aside after five tries: kept, no longer taken up, in the worker's log and its health answer.
# A run holds its project's lock for ten minutes at most; what it didn't reach is the next run's.
# The worker looks for waiting jobs every five seconds. A map server has thirty seconds to answer
# one question; one that doesn't is a ticket that could not be processed, never a straight line.
JOB_TRIES_BEFORE_SET_ASIDE=5
RECONCILIATION_RUN_LONGEST_MINUTES=10
JOB_QUEUE_POLL_SECONDS=5
MAP_SERVER_ANSWER_SECONDS=30

# The size of a job (ARCHITECTURE §13; ADR-420), read by the API and the worker alike; either's
# own env file may state another (ADR-395), and the two should agree. A change that touches more
# tickets than this is queued as several jobs of this size, and a run takes up its project's
# waiting jobs, the oldest first, until their tickets come to this many (one job at the least), so
# that a run always has a size it can finish inside RECONCILIATION_RUN_LONGEST_MINUTES.
JOB_TICKETS_AT_MOST=200
