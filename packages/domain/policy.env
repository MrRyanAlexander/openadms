# Open ADMS policy values: the built-in defaults (invariant 16; ADR-303).
#
# A threshold is policy, never a number in code. These are the values a release ships with: what a
# new project's settings start as, before the firm changes them on the project (audited). The names
# are packages/domain's (src/policy.ts), which refuses a value that is missing or out of range.
# No secret belongs in this file: it is committed.

# A load call at or under the low limit, or at or over the high limit, is flagged (ADR-164).
# A project may change either, or switch them off; a 0% load call is flagged either way (ADR-181).
LOAD_CALL_LOW_LIMIT=5
LOAD_CALL_HIGH_LIMIT=95

# The circle round a disposal site's GPS, in metres, for a site without its own shape (ADR-142).
# A project changes it in its GIS settings.
DISPOSAL_SITE_PROXIMITY_M=200

# The root-ball height the stump fill is worked out with, in inches: the USACE Stump Conversion
# Guide's (ADR-183, 203). A project changes it for a contract that says otherwise.
STUMP_FILL_DEPTH_INCHES=31

# A crew day's length, in hours, on a pay item that pays crew time by the crew day by exact
# division: the hours ÷ this (ADR-087, 309). The firm changes it on the pay item.
CREW_DAY_HOURS=12

# How many unused numbers a phone holds after a top-up at a sync: ticket numbers on a phone that
# makes them (ADR-065), cert numbers on a certifying phone (ADR-181), ROE numbers (ADR-323). A
# phone gives its block out in order, offline; gaps in a series are normal.
TICKET_NUMBER_BLOCK_SIZE=1000
CERT_NUMBER_BLOCK_SIZE=100
ROE_NUMBER_BLOCK_SIZE=100

# The largest body the API reads from one request, in bytes (ARCHITECTURE §6, Input; ADR-389): one
# mebibyte. A request that says it is larger, or turns out to be, is refused before it is read
# whole. An endpoint that must take more (a photograph) states its own limit with its task. An
# installation may raise it, never lower it: a phone's sync weighs up to a mebibyte, and one
# refused for its size would be refused at every try (ADR-504).
REQUEST_BODY_LIMIT_BYTES=1048576

# How long one statement of a service's database login may run, in milliseconds, before the
# database stops it (ARCHITECTURE §5.7; ADR-394): thirty seconds. `pnpm installer` sets it on the
# API's, the worker's and the read-only login, never on the owner's (migrations). A wait for a
# lock counts. A service's own env file may state another for its logins (ADR-395).
STATEMENT_TIMEOUT_MS=30000

# The most connections one service's pool opens to the database (ARCHITECTURE §5.7; ADR-419): ten
# for the API and ten for the worker, each by its own login. Never under two: a run of the worker
# holds its project's lock on one connection and writes on another. A service's own env file may
# state another (ADR-395); the database's own max_connections must hold them all.
DATABASE_POOL_CONNECTIONS=10

# How long one piece of work (a service's transaction) waits for a connection from its pool before
# it gives up, in milliseconds (ARCHITECTURE §5.7; ADR-524): two seconds, Prisma's own, stated.
# A request whose work couldn't start in time is told the database is busy, never answered 500.
# Read by each service for its own pool.
DATABASE_CONNECTION_WAIT_MS=2000

# How long one piece of work may run in all, in milliseconds, before it is undone (ADR-524): five
# seconds, Prisma's own, stated. A statement in it is still stopped at STATEMENT_TIMEOUT_MS. A
# request whose work ran out of time is told the database is busy. Read by each service.
DATABASE_WORK_LONGEST_MS=5000

# How many seconds a caller told the database is busy is told to wait before asking again
# (`503 BUSY` with `Retry-After`; ARCHITECTURE §6, Abuse; RFC 9110 §15.6.4; ADR-524): five.
# Nothing it sent was kept but what it was answered saved before. Read by the API alone.
DATABASE_BUSY_RETRY_SECONDS=5

# The shortest password a back-office or outside user may set, in characters, each Unicode code
# point counted as one (ARCHITECTURE §6, Passwords; NIST SP 800-63B-4 §3.1.1.2; ADR-402): fifteen,
# what the standard asks where a password may be the only thing a person signs in with (a
# read-only viewer's second step is optional, ADR-170). Never under eight. A monitor's password is
# exempt (ADR-105). The longest is far over the 64 the standard says must be permitted.
PASSWORD_MINIMUM_LENGTH=15
PASSWORD_MAXIMUM_LENGTH=128

# How long a password reset sent by email stays good, in minutes (ADR-404): one hour. The standard
# allows a day at most (NIST SP 800-63B-4 §4.2). It is spent the moment the password changes.
PASSWORD_RESET_MINUTES=60

# A back-office or outside user's session (ARCHITECTURE §6, Back-office sessions; ADR-408). The
# access token is good for five minutes; the page gets a new one with its refresh token. A session
# nobody asks anything of ends after thirty minutes, and every session ends twelve hours after
# its sign-in, whatever is asked of it. NIST SP 800-63B-4 §2.2.3 says no more than an hour and no
# more than a day where a second step is required, and the ranges stop there.
ACCESS_TOKEN_MINUTES=5
SESSION_INACTIVITY_MINUTES=30
SESSION_OVERALL_HOURS=12

# Wrong tries at one login (ARCHITECTURE §6, Abuse; NIST SP 800-63B-4 §3.2.2; ADR-409). After five
# in a row the login waits before it may be tried again: thirty seconds, then twice as long after
# each further wrong try, an hour at the most (from the twelfth). After fifty in a row it is
# locked until its password is set anew (a reset by email, or an admin). The standard's limit is
# a hundred. Fifty, not fewer (the user, ADR-417): a lock anybody's wrong tries can cause keeps
# the real person out, so it comes late, and the waits and the limits by address do the work
# before it. The number before a wait is that of a phone's own sign-in screen (ARCHITECTURE §7.2).
SIGN_IN_TRIES_BEFORE_WAIT=5
SIGN_IN_TRIES_BEFORE_LOCK=50
SIGN_IN_FIRST_WAIT_SECONDS=30
SIGN_IN_LONGEST_WAIT_MINUTES=60

# Two-step sign-in (ARCHITECTURE §6; ADR-170, 412). An authenticator app shows a new six-digit
# code every thirty seconds. The server takes in the code of its own thirty seconds and of this
# many steps before and after it: one, for a phone's clock that runs a little off and the time it
# takes to type (NIST SP 800-63B-4 §3.1.4.2; RFC 6238 §5.2). Nought takes the server's own step
# alone, the strictest reading of ASVS 6.5.5's thirty seconds. Never more than one. A code is
# good once whatever this says. Setting an authenticator up must be finished within ten minutes.
TWO_STEP_CODE_STEPS_EITHER_SIDE=1
TWO_STEP_SETUP_MINUTES=10

# A phone's proof of itself (ARCHITECTURE §7.4; NIST SP 800-63B-4 §3.1.6.2; ADR-437). Before a
# sync the server makes the phone a challenge, and the phone signs it with its device key. The
# challenge may be sent back signed for two minutes: long enough for a weak connection at the
# edge of signal, short enough that one left lying is soon worth nothing. A challenge is good
# once whatever this says.
PHONE_CHALLENGE_SECONDS=120

# What a proof gives (NIST SP 800-63B-4 §5.1; ADR-440): a token for that phone, which the calls
# of its sync carry. It is good for fifteen minutes: long enough for a sync's records and a
# slow photograph or two, short enough that one taken off the wire is soon worth nothing. A
# phone proves itself again for another, at any time; a phone whose key is revoked is refused
# at once, whatever its token says.
PHONE_TOKEN_MINUTES=15

# A monitor's sign-in on a phone (ARCHITECTURE §6, Device sessions; §7.2; ADR-441 (6), 443, 531). It
# lasts a working day: a day after the monitor signed in (the user: shifts run from six in the
# morning to seven or eight at night and never past a day), and it doesn't end for quiet, since a
# phone is out of signal most of the day (the phone's own lock after inactivity is the field
# app's). What a new installation's firm settings start as; an admin then changes it, audited.
# NIST SP 800-63B-4 §2.2.3 allows a day at most, and the range stops there.
MONITOR_SESSION_HOURS=24

# The phone's own sign-in screen (ARCHITECTURE §7.2 (3); ADR-139, 575). A password checked against
# the phone's login list, with no connection, is a guess nobody else counts: so the phone counts
# its own. From the fifth wrong try in a row each one puts a wait on the screen, twice as long as
# the one before (thirty seconds, then a minute, two, four, eight), never over the longest; at
# the tenth the screen locks until the master passcode is typed. NIST SP 800-63B-4 §3.2.10 allows
# ten wrong tries at most for a secret checked on the device, and the range stops there. A sign-in
# that works starts the count again. Read by the field app's build; the server keeps its own count.
PHONE_SIGN_IN_TRIES_BEFORE_WAIT=5
PHONE_SIGN_IN_TRIES_BEFORE_LOCK=10
PHONE_SIGN_IN_FIRST_WAIT_SECONDS=30
PHONE_SIGN_IN_LONGEST_WAIT_MINUTES=15

# The phone's lock after inactivity (ARCHITECTURE §7.2; ADR-139, 575): a monitor's sign-in closes
# after this many minutes with nothing touched, and the phone warns this many seconds before, one
# tap keeping it (WCAG 2.2.1 asks twenty seconds at least). Nothing not yet submitted is lost: the
# monitor signs in again and carries on. Thirty minutes, the back office's own quiet time: NIST SP
# 800-63B-4 §2.2.3 asks an hour at most where a second factor is used (the phone's key), and a
# tower may wait that long between trucks only rarely. Read by the field app's build.
PHONE_INACTIVITY_LOCK_MINUTES=30
PHONE_INACTIVITY_WARNING_SECONDS=60

# How often a phone with a monitor signed in syncs on its own, in minutes (ARCHITECTURE §9; the
# user, ADR-588): it tries this often whether or not it has signal, besides signing in, finding a
# connection, coming back to the front and the monitor asking. Five, the user's: "at least every
# 5 minutes". A try with no signal costs the phone nothing but the try. Read by the field app's
# build.
PHONE_SYNC_EVERY_MINUTES=5

# A phone's login list (ARCHITECTURE §7.2; ADR-449, 454). Each entry is a slow hash the server
# makes for that phone and monitor: about a hundredth of a second of a processor each, measured
# 2026-10-09, so a project of three hundred monitors is some four seconds for a phone that holds
# none. The server makes at most this many in one call and says there are more; the phone asks
# again, saying what it now holds. Entries a phone already holds are never made again.
LOGIN_LIST_ENTRIES_PER_CALL=50

# An address looked up for a phone's GPS (ARCHITECTURE §3; AC-04-24; ADR-455). The API asks our
# own address server and a monitor waits at the curb for the answer, so the address server has
# five seconds to give it: one that doesn't is answered "no answer" and the monitor types the
# street number and name, as with no connection. Never the worker's thirty seconds below: no
# person waits on those.
ADDRESS_LOOKUP_ANSWER_SECONDS=5

# The object store the API keeps files in (ARCHITECTURE §11; ADR-480). One question of it, a
# file put or read whole, has thirty seconds from the connection to the last byte; one that takes
# longer is no answer, and the phone that was sending the file sends it again later.
MEDIA_STORE_ANSWER_SECONDS=30

# A photograph's file, taken by the media endpoint (ARCHITECTURE §6 "Uploads", §9 (5), §11;
# ADR-482). A file is at most 32 MiB: a phone's photograph at full resolution, re-encoded at high
# quality, is a few; the sizes are measured on real phones before they are fixed (Phase 3). A
# phone sends it in parts of at most 4 MiB, smaller where its signal is poor, and an interrupted
# upload goes on from the last part the server took. The API holds 256 MiB at most of files not
# yet whole, across every phone, in its own memory; past that the part longest waiting goes, and
# its phone is told to start that file again. One phone may send 300 parts in the rate limits'
# stretch (five a second), and is answered 429 LIMITED past it.
MEDIA_FILE_BYTES_AT_MOST=33554432
MEDIA_PART_BYTES_AT_MOST=4194304
MEDIA_RECEIVING_BYTES_AT_MOST=268435456
RATE_LIMIT_FILE_PARTS_PER_PHONE=300

# A map's file, sent by the back office to the map's own route (ARCHITECTURE §3 "Project boundary
# and zones"; ADR-485): a zipped shapefile or a GeoJSON file, the boundary, zones or a site's own
# shape, is at most 16 MiB, sent whole in one request; every other request keeps the body limit
# above. A zipped file's parts may come to 64 MiB at most, unzipped: they are unzipped no further
# than that, and a file that would go past it isn't read or kept. A zip holds 1,000 files at
# most, counted before any is unzipped (a shapefile is four or five). Agent defaults: a county's
# boundary and zones are a few MiB; measured on the firms' own files when the back office's map
# screen is built (Phase 4).
MAP_FILE_BYTES_AT_MOST=16777216
MAP_FILE_UNZIPPED_BYTES_AT_MOST=67108864
MAP_FILE_ENTRIES_AT_MOST=1000

# The most outer rings times holes one shape of a shapefile may have and still be read (ADR-524;
# C140): fifty million. Setting each hole in its outer ring tries every pair, all at once in the
# API's process, which nothing stops part way: measured on 2026-10-14, sixteen million pairs took
# 0.1 s, sixty-four million 0.4 s, a thousand million 7.4 s. Islands without holes pair nothing.
# A shape over it is refused in plain words: simplify it, or split it. Agent default.
MAP_FILE_RING_PAIRS_AT_MOST=50000000

# An Esri feature layer linked as a project's map or a site's shape (ARCHITECTURE §3; ADR-527
# (15)): the API asks it for every feature as GeoJSON, a page at a time, before any database work,
# and the whole exchange, every page of every layer asked, has sixty seconds; its copies come to
# MAP_FILE_BYTES_AT_MOST together. A county's boundary and zones are a few pages. Agent default.
ESRI_LAYER_ANSWER_SECONDS=60

# Rate limits on every request (ARCHITECTURE §6, Abuse; OWASP ASVS 5.0 2.4.1; ADR-416). Requests
# are counted over a minute. One address may send three thousand in it (fifty a second): a firm's
# whole office, and its phones on the office's network, usually reach the server from one address.
# One signed-in person may send six hundred, from whatever address, and so may one proven phone
# (ADR-490): a phone's requests are counted for it as well as for its address, whoever is signed in
# on it, so one phone can't spend its office's count. A caller over a limit is
# answered 429 LIMITED and told how many seconds to wait. The server keeps the counts in its own
# memory, a hundred thousand callers' at once; past that the oldest goes.
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_REQUESTS_PER_ADDRESS=3000
RATE_LIMIT_REQUESTS_PER_ACCOUNT=600
RATE_LIMIT_REQUESTS_PER_PHONE=600
RATE_LIMIT_COUNTS_KEPT=100000

# Tries at sign-in from one address (ASVS 6.1.1, 6.3.1; NIST SP 800-63B-4 §3.2.2; ADR-416),
# counted over an hour. One address may be refused thirty times, whoever's login it tried: a
# sign-in, a reset's code, a current password, an authenticator's code. At one login it may be
# refused four times: fewer than put a wait on the login (SIGN_IN_TRIES_BEFORE_WAIT, and always
# under it), so a stranger at one address is stopped before the login's own count is spent, and a
# try stopped here never counts against the login. A sign-in that works from that address, or the
# login's password set anew, starts that count again. One address may ask for ten resets by
# email, and three may be asked for one login, whoever asks.
SIGN_IN_ADDRESS_WINDOW_MINUTES=60
SIGN_IN_WRONG_TRIES_PER_ADDRESS=30
SIGN_IN_WRONG_TRIES_PER_ADDRESS_AT_LOGIN=4
PASSWORD_RESET_ASKS_PER_ADDRESS=10
PASSWORD_RESET_ASKS_PER_LOGIN=3

# The master passcode's shortest and longest, in characters, each Unicode code point counted as
# one (ARCHITECTURE §7.5; ADR-266, 530): the firm's first, asked by the installer, and each change
# made in the back office. Eight, what the standard allows beside the phone that holds the key it
# opens with (NIST SP 800-63B-4 §3.1.1.2); never over the password's own bounds.
MASTER_PASSCODE_MINIMUM_LENGTH=8
MASTER_PASSCODE_MAXIMUM_LENGTH=128

# A phone marked lost or retired keeps its device key this many hours, counted from the mark,
# before the worker revokes it (REQ-214; ADR-520, 530): a day. What a new installation's firm
# settings start as; the firm then changes it, in hours or off, audited. Nought starts it off. A
# phone revoked so may still sync and be turned in under the master passcode.
PHONE_KEY_REVOKED_AFTER_HOURS=24

# The worker (ARCHITECTURE §13; ADR-418, 419), read by the worker's process alone; its own env
# file (apps/worker/.env) may state another (ADR-395). A job that fails whole (the process died,
# the database was away, the run's time ran out) is taken up again by its project's next run, and
# set aside after five tries: kept, no longer taken up, in the worker's log and its health answer.
# A run holds its project's lock for ten minutes at most; what it didn't reach is the next run's.
# The worker looks for waiting jobs every five seconds. A map server has thirty seconds to answer
# one question; one that doesn't is a ticket that could not be processed, never a straight line.
JOB_TRIES_BEFORE_SET_ASIDE=5
RECONCILIATION_RUN_LONGEST_MINUTES=10
JOB_QUEUE_POLL_SECONDS=5
MAP_SERVER_ANSWER_SECONDS=30

# A phone's clock at a sync (ARCHITECTURE §10; ADR-100, 473), read by the worker alone. Every
# phone reports its clock when it syncs and the server keeps how far it stood from its own. A
# sync whose phone's clock was more than this many whole minutes off, ahead or behind, has its
# field events flagged "device clock was 2 h 14 m off at sync"; they still bill. Five minutes: a
# phone that sets its clock from the network is seconds off, and the checks between two field
# events read times to the minute. A day at the most.
DEVICE_CLOCK_OFF_LIMIT_MINUTES=5

# The size of a job (ARCHITECTURE §13; ADR-420), read by the API and the worker alike; either's
# own env file may state another (ADR-395), and the two should agree. A change that touches more
# tickets than this is queued as several jobs of this size, and a run takes up its project's
# waiting jobs, the oldest first, until their tickets come to this many (one job at the least), so
# that a run always has a size it can finish inside RECONCILIATION_RUN_LONGEST_MINUTES; a job
# behind them whose tickets the run already works rides with it (ADR-506). Read apart (ADR-506):
# the API's is the most a job names (a setup change's cut, the reprocess endpoint's most); the
# worker's is the most a run takes up past its first job. A job is always taken up whole, so a
# worker's number under the API's only makes every run one job; the worker's is the one that
# sizes a run where many small jobs wait (a burst's, each naming its one ticket). Measured on a
# thousand loads (ADR-506): a run of 200 took 1.2 to 1.7 s, 0.18 s of it what every run does, and
# one of 1,000 took 6.9 s, against the ten minutes a run may hold its project's lock.
JOB_TICKETS_AT_MOST=200

# What one phone may make the server hold for a person in a day (ARCHITECTURE §9 (4); ADR-546; the
# Phase 2 audit's F7). Whatever a sync can't save is held whole for a person, and a phone may sync
# hundreds of times a minute: so a stolen phone, or a monitor scripting its token, could fill the
# database. Past either number in the last 24 hours its records are still received and held (flag,
# never block), but a security event is written, every admin is told by mail, and the phone is
# marked on the phones list; taking it out of service stays a person's act. Sixteen mebibytes and a
# thousand records: an honest phone holds a handful in a month.
PHONE_HELD_BYTES_PER_DAY=16777216
PHONE_HELD_RECORDS_PER_DAY=1000

# A map file is read apart from the API's own work (ARCHITECTURE §3 "Project boundary and zones";
# ADR-548; the Phase 2 audit's F9): in a worker thread of its own, stopped past this many seconds
# or this much memory, so a file that takes long or a malformed one never holds the server for
# everybody else, and is answered as one that can't be read. Sixty seconds and 512 MiB: a county's
# zones read in under two seconds, and a file at the upload limit unzips to at most 64 MiB.
MAP_FILE_READ_SECONDS=60
MAP_FILE_READ_MEMORY_MEBIBYTES=512

# The most waypoints one collection takes (ADR-571, 581; Q-104; AC-11-77): "Mark waypoint" records
# the phone's time and whatever fix it has, in order, while the collection is open. Fifty: a curb
# load marked every few houses along a street needs a handful. The field app offers no more and
# says so when the monitor reaches it; the sync contract reads no more than this value's most.
# Read by the field app's build; nothing in the engine reads a waypoint.
FIELD_EVENT_WAYPOINTS_AT_MOST=50
