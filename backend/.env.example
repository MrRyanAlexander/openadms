# ---------------------------------------------------------------------------
# Open ADMS API
# The database is addressed through exactly one variable.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://adms:adms@127.0.0.1:5432/openadms

# Sign your own. openssl rand -hex 32
JWT_SECRET=change-me-in-production
ACCESS_TOKEN_MINUTES=60
REFRESH_TOKEN_DAYS=30

# Accepts dynamically generated frontend URLs by pattern rather than by list.
CORS_ORIGIN_REGEX=^https?://(localhost(:\d+)?|127\.0\.0\.1(:\d+)?|[a-z0-9-]+\.netlify\.app|[a-z0-9-]+\.netlify\.live|[a-z0-9-]+\.up\.railway\.app|[a-z0-9-]+\.onrender\.com)$
CORS_ALLOW_ORIGINS=

# Federation. The installer mints this; leave blank to have the API generate one.
INSTANCE_KEY=
PEER_SIGNATURE_SKEW_SECONDS=300
REGISTRY_URL=

ENVIRONMENT=development
PORT=8080
LOG_LEVEL=info
