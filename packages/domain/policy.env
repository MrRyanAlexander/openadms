# Open ADMS policy values: the built-in defaults (invariant 16; ADR-303).
#
# A threshold is policy, never a number in code. These are the values a release ships with: what a
# new project's settings start as, before the firm changes them on the project (audited). The names
# are packages/domain's (src/policy.ts), which refuses a value that is missing or out of range.
# No secret belongs in this file: it is committed.

# A load call at or under the low limit, or at or over the high limit, is flagged (ADR-164).
# A project may change either, or switch them off; a 0% load call is flagged either way (ADR-181).
LOAD_CALL_LOW_LIMIT=5
LOAD_CALL_HIGH_LIMIT=95

# The circle round a disposal site's GPS, in metres, for a site without its own shape (ADR-142).
# A project changes it in its GIS settings.
DISPOSAL_SITE_PROXIMITY_M=200

# The root-ball height the stump fill is worked out with, in inches: the USACE Stump Conversion
# Guide's (ADR-183, 203). A project changes it for a contract that says otherwise.
STUMP_FILL_DEPTH_INCHES=31

# A crew day's length, in hours, on a pay item that pays crew time by the crew day by exact
# division: the hours ÷ this (ADR-087, 309). The firm changes it on the pay item.
CREW_DAY_HOURS=12

# How many unused numbers a phone holds after a top-up at a sync: ticket numbers on a phone that
# makes them (ADR-065), cert numbers on a certifying phone (ADR-181), ROE numbers (ADR-323). A
# phone gives its block out in order, offline; gaps in a series are normal.
TICKET_NUMBER_BLOCK_SIZE=1000
CERT_NUMBER_BLOCK_SIZE=100
ROE_NUMBER_BLOCK_SIZE=100

# The largest body the API reads from one request, in bytes (ARCHITECTURE §6, Input; ADR-389): one
# mebibyte. A request that says it is larger, or turns out to be, is refused before it is read
# whole. An endpoint that must take more (a photograph) states its own limit with its task.
REQUEST_BODY_LIMIT_BYTES=1048576

# How long one statement of a service's database login may run, in milliseconds, before the
# database stops it (ARCHITECTURE §5.7; ADR-394): thirty seconds. `pnpm installer` sets it on the
# API's, the worker's and the read-only login, never on the owner's (migrations). A wait for a
# lock counts. A service's own env file may state another for its logins (ADR-395).
STATEMENT_TIMEOUT_MS=30000

# The shortest password a back-office or outside user may set, in characters, each Unicode code
# point counted as one (ARCHITECTURE §6, Passwords; NIST SP 800-63B-4 §3.1.1.2; ADR-402): fifteen,
# what the standard asks where a password may be the only thing a person signs in with (a
# read-only viewer's second step is optional, ADR-170). Never under eight. A monitor's password is
# exempt (ADR-105). The longest is far over the 64 the standard says must be permitted.
PASSWORD_MINIMUM_LENGTH=15
PASSWORD_MAXIMUM_LENGTH=128

# How long a password reset sent by email stays good, in minutes (ADR-404): one hour. The standard
# allows a day at most (NIST SP 800-63B-4 §4.2). It is spent the moment the password changes.
PASSWORD_RESET_MINUTES=60
